{
  "name": "takipplus-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/lastmod.mjs && node scripts/brand-assets.mjs && node scripts/og-images.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-dist.mjs",
    "preview": "astro preview",
    "qa:shots": "node scripts/qa/shots.mjs http://localhost:4322 ./.qa",
    "qa:behavior": "node scripts/qa/behavior.mjs http://localhost:4322 ./.qa",
    "fonts": "python scripts/subset-fonts.py",
    "serve": "node scripts/serve.mjs 4322",
    "test:live": "node scripts/smoke.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "qa:visual": "node scripts/qa/visual.mjs",
    "qa:audit": "node scripts/qa/audit.mjs http://localhost:4322 .qa/audit.json",
    "qa:xb": "node scripts/qa/cross-browser.mjs http://localhost:4322 .qa/xb"
