{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "https://takipplus.com.tr/", "statusCode": 301 },
    { "source": "/index", "destination": "https://takipplus.com.tr/", "statusCode": 301 },
    { "source": "/gizlilik-politikasi.html", "destination": "https://takipplus.com.tr/gizlilik", "statusCode": 301 },
    { "source": "/gizlilik-politikasi", "destination": "https://takipplus.com.tr/gizlilik", "statusCode": 301 },
    { "source": "/kullanim-sartlari.html", "destination": "https://takipplus.com.tr/kullanim-sartlari", "statusCode": 301 },
    { "source": "/kvkk", "destination": "https://takipplus.com.tr/kvkk-aydinlatma", "statusCode": 301 },
    { "source": "/hakkinda", "destination": "https://takipplus.com.tr/hakkimizda", "statusCode": 301 },
    { "source": "/basin", "destination": "https://takipplus.com.tr/marka", "statusCode": 301 },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www\\.takipplus\\.com\\.tr" }],
      "destination": "https://takipplus.com.tr/:path",
      "statusCode": 301
    },
    { "source": "/:path(.+)\\.html", "destination": "/:path", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml" },
    { "source": "/:page((?!404$)[a-z0-9-]+)", "destination": "/:page.html" },
    { "source": "/:dir([a-z0-9-]+)/:page([a-z0-9-]+)", "destination": "/:dir/:page.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests; report-uri /api/csp-report"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), browsing-topics=()"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/erken-erisim/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/_assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/videos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(og|brand|icons|badges)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
