---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { screens, SCREEN_W, SCREEN_H, type ScreenName } from '../data/screens';

interface Props {
  screen: ScreenName;
  /** CSS genişliği (px). srcset 1x/2x/3x buna göre üretilir. */
  width?: number;
  eager?: boolean;
  class?: string;
}

const { screen, width = 280, eager = false, class: cls } = Astro.props;
const files = import.meta.glob<ImageMetadata>('/assets/screens/*.png', { eager: true, import: 'default' });
const img = files[`/assets/screens/${screen}.png`];
const meta = screens[screen];
const widths = [1, 2, 3].map((x) => Math.min(width * x, SCREEN_W));
---

<figure class:list={['device', cls]} style={`--device-w:${width}px`} data-screen={screen}>
  <div class="device__body">
    <div class="device__screen">
      {
        img ? (
          <Picture
            src={img}
            alt={meta.alt}
            widths={widths}
            sizes={`${width}px`}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            width={SCREEN_W}
            height={SCREEN_H}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : undefined}
          />
        ) : (
          <div class="device__placeholder" role="img" aria-label={`${meta.label} ekranı: ekran görüntüsü yakında eklenecek`}>
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span class="device__ph-title">{meta.label}</span>
            <span class="device__ph-note">Ekran görüntüsü yakında</span>
            {import.meta.env.DEV && <code class="device__ph-file">assets/screens/{screen}.png</code>}
          </div>
        )
      }
    </div>
    <span class="device__island" aria-hidden="true"></span>
  </div>
</figure>

<style is:global>
  .device {
    --bezel: calc(var(--device-w) * 0.035);
    width: min(var(--device-w), 100%);
    margin: 0;
    flex: none;
  }

  .device__body {
    position: relative;
    padding: var(--bezel);
    border-radius: calc(var(--device-w) * 0.16);
    background: linear-gradient(145deg, #2a3350, #11172a 40%, #0b0f1d);
    box-shadow:
      0 0 0 1px rgb(148 163 184 / 0.22) inset,
      0 0 0 1.5px #05070f,
      var(--shadow-3);
  }

  .device__screen {
    position: relative;
    aspect-ratio: 1290 / 2796;
    overflow: hidden;
    border-radius: calc(var(--device-w) * 0.13);
    background: var(--bg);
  }

  .device__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .device__island {
    position: absolute;
    top: calc(var(--bezel) + var(--device-w) * 0.035);
    left: 50%;
    width: 30%;
    height: calc(var(--device-w) * 0.085);
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }

  .device__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--text-2);
    background:
      radial-gradient(90% 50% at 20% 0%, rgb(139 92 246 / 0.22), transparent 70%),
      radial-gradient(80% 40% at 100% 100%, rgb(45 212 191 / 0.12), transparent 70%),
      var(--bg);
  }

  .device__placeholder svg {
    color: var(--violet-400);
    margin-bottom: 0.25rem;
  }

  .device__ph-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text);
  }

  .device__ph-note {
    font-size: var(--text-xs);
  }

  .device__ph-file {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--amber-500);
    word-break: break-all;
  }
</style>
