---
/**
 * Başarımlar: uygulamadaki "Başarımlarım" ekranının küçük hâli
 * (lib/screens/achievements_screen.dart): özet kartı, madalyonlu seviye
 * kutuları ve başarım kartları. Renkler achievement_model.dart'tan,
 * ikonlar uygulamayla aynı Material Rounded setinden (Apache 2.0).
 * Film, dizi, oyun ya da gerçek kişi adı taşıyan başarımlar sitede
 * gösterilmez; örnekler genel adlı başarımlardan seçildi. Sayılar örnektir.
 */
const I = {
  medal:
