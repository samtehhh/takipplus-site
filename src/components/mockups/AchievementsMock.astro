---
/**
 * Başarımlar: uygulamadaki "Başarımlarım" kartlarıyla aynı yapı.
 * Seviye sayıları lib/data/achievements_data.dart'tan (toplam 55).
 * Film, dizi, oyun ya da gerçek kişi adı taşıyan başarımlar sitede
 * gösterilmez; örnekler genel adlı başarımlardan seçildi.
 */
const tiers = [
  { n: 'Bronz', c: '#CD7F32', count: 18 },
  { n: 'Gümüş', c: '#C0C0C0', count: 13 },
  { n: 'Altın', c: '#FFD700', count: 16 },
  { n: 'Efsanevi', c: '#8B5CF6', count: 8 },
];

const items = [
  {
    t: 'Ebedi',
    d: 'Ligde 60 gün boyunca Top 3 arasında bulun.',
    tier: 'Efsanevi',
    c: '#8B5CF6',
    icon: 'M5 20V10M12 20V4M19 20v-7',
    unlocked: true,
  },
  {
    t: 'Yol Ayrımı',
    d: 'Hedef alanını değiştir.',
    tier: 'Bronz',
    c: '#CD7F32',
    icon: 'M12 21v-7M12 14 6 8M12 14l6-6M6 8V4M6 4H2M18 8V4h4',
    unlocked: true,
  },
  {
    t: 'Sisifos',
    d: 'Hedefin olan netleri 60 gün boyunca göremeden geçir.',
    tier: 'Gümüş',
    c: '#C0C0C0',
    icon: 'M4 17l5-5 4 4 7-8M15 8h5v5',
    unlocked: false,
  },
];
---

<div class="mock ach" role="img" aria-label="Başarımlar örneği: 18 bronz, 13 gümüş, 16 altın ve 8 efsanevi olmak üzere 55 başarım">
  <ul class="ach__tiers" aria-hidden="true">
    {
      tiers.map((t) => (
        <li style={`--c:${t.c}`}>
          <span class="num">{t.count}</span>
          {t.n}
        </li>
      ))
    }
  </ul>
  <ul class="ach__list" aria-hidden="true">
    {
      items.map((a) => (
        <li class:list={['ach__item', { 'is-locked': !a.unlocked }]} style={`--c:${a.c}`}>
          <span class="ach__icon">
            <svg viewBox="0 0 24 24" width="20" height="20">
              <path d={a.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="ach__body">
            <span class="ach__head">
              <span class="ach__t">{a.t}</span>
              <span class="ach__tier">{a.tier}</span>
            </span>
            <span class="ach__d">{a.d}</span>
          </span>
          {!a.unlocked && (
            <svg class="ach__lock" viewBox="0 0 24 24" width="18" height="18">
              <rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor" />
              <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          )}
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  .ach {
    container-type: inline-size;
    display: grid;
    gap: 0.875rem;
    padding: 1rem;
    border-radius: 22px;
  }

  .ach__tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.375rem;
    list-style: none;
  }

  .ach__tiers li {
    display: grid;
    justify-items: center;
    padding: 0.5rem 0.25rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 10%, transparent);
    color: color-mix(in srgb, var(--c) 80%, white);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .ach__tiers .num {
    font-size: 1rem;
    color: var(--text);
  }

  .ach__list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  .ach__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: 16px;
    background: rgb(10 10 26 / 0.35);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
  }

  .ach__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c) 18%, transparent);
    color: var(--c);
  }

  .ach__body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .ach__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .ach__t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .ach__tier {
    padding: 0.0625rem 0.4375rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--c) 18%, transparent);
    color: color-mix(in srgb, var(--c) 75%, white);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .ach__d {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-2);
  }

  @container (max-width: 19rem) {
    .ach__tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ach__item.is-locked {
    border-color: var(--line);
  }

  .ach__item.is-locked :is(.ach__icon, .ach__t) {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .ach__lock {
    color: var(--ink-500);
  }
</style>
