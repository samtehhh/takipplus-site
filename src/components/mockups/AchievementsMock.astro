    'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM9.29 16.29 5.7 12.7a.996.996 0 1 1 1.41-1.41L10 14.17l6.88-6.88a.996.996 0 1 1 1.41 1.41l-7.59 7.59a.996.996 0 0 1-1.41 0z',
  lock: 'M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z',
};

// achievement_model.dart: Bronz #CD7F32, Gümüş #C0C0C0, Altın #FFD700, Efsanevi #8B5CF6
const tiers = [
  { n: 'Bronz', c: '#CD7F32', done: 1, total: 18 },
  { n: 'Gümüş', c: '#C0C0C0', done: 2, total: 13 },
  { n: 'Altın', c: '#FFD700', done: 1, total: 16 },
  { n: 'Efsanevi', c: '#8B5CF6', done: 1, total: 8 },
];
const unlocked = tiers.reduce((s, t) => s + t.done, 0);
const total = tiers.reduce((s, t) => s + t.total, 0);
const pct = Math.round((unlocked / total) * 100);

const items = [
  { t: 'Hesaplaşma', d: 'Seni düelloda geçmiş bir kişiyi 1 kez geç.', tier: 'Bronz', c: '#CD7F32', icon: I.duel, unlocked: true },
  { t: 'Ebedi', d: 'Ligde 60 gün boyunca Top 3 arasında bulun.', tier: 'Efsanevi', c: '#8B5CF6', icon: I.sparkle, unlocked: true },
  { t: 'Sisifos', d: 'Hedefin olan netleri 60 gün boyunca göremeden geçir.', tier: 'Gümüş', c: '#C0C0C0', icon: I.terrain, unlocked: false },
];
---

<div
  class="mock ach"
  role="img"
  aria-label={`Başarımlar örneği: ${unlocked} / ${total} başarım açıldı. Seviyeler: 18 bronz, 13 gümüş, 16 altın, 8 efsanevi.`}
>
  <div class="ach__summary" aria-hidden="true">
    <div class="ach__head">
      <span class="ach__trophy">
        <svg viewBox="0 0 24 24" width="24" height="24"><path d={I.trophy} fill="currentColor" /></svg>
      </span>
      <span class="ach__progress">
        <span class="ach__count">{unlocked} / {total} başarım açıldı</span>
        <span class="ach__bar"><span style={`width:${pct}%`} /></span>
      </span>
      <span class="ach__pct">%{pct}</span>
    </div>
    <ul class="ach__tiers">
      {
        tiers.map((t) => (
          <li style={`--c:${t.c}`}>
            <svg viewBox="0 0 24 24" width="20" height="20">
              <path d={I.medal} fill="currentColor" />
            </svg>
            <span class="ach__tier-n num">
              {t.done}/{t.total}
            </span>
            <span class="ach__tier-l">{t.n}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <ul class="ach__list" aria-hidden="true">
    {
      items.map((a) => (
        <li class:list={['ach__item', { 'is-locked': !a.unlocked }]} style={`--c:${a.c}`}>
          <span class="ach__icon">
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path d={a.icon} fill="currentColor" />
            </svg>
          </span>
          <span class="ach__body">
            <span class="ach__row">
              <span class="ach__t">{a.t}</span>
              <span class="ach__badge">{a.tier}</span>
            </span>
            <span class="ach__d">{a.d}</span>
          </span>
          <svg class="ach__state" viewBox="0 0 24 24" width="20" height="20">
            <path d={a.unlocked ? I.check : I.lock} fill="currentColor" />
          </svg>
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  .ach {
    container-type: inline-size;
    display: grid;
    gap: 0.75rem;
    padding: 0.875rem;
    border-radius: 22px;
  }

  /* Özet kartı */
  .ach__summary {
    display: grid;
    gap: 0.875rem;
    padding: 1rem;
    border-radius: 18px;
    background: rgb(255 255 255 / 0.03);
    border: 1px solid rgb(139 92 246 / 0.18);
  }

  .ach__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .ach__trophy {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--violet-500), var(--teal-400));
    box-shadow: 0 5px 14px rgb(139 92 246 / 0.4);
    color: #fff;
  }

  .ach__progress {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .ach__count {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  .ach__bar {
    height: 6px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  .ach__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--violet-500);
  }

  .ach__pct {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.125rem;
    color: var(--violet-500);
  }

  /* Madalyonlu seviye kutuları */
  .ach__tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.4375rem;
    list-style: none;
  }

  .ach__tiers li {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding: 0.5rem 0.25rem;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 25%, transparent);
    background: color-mix(in srgb, var(--c) 8%, transparent);
  }

  .ach__tiers svg {
    color: var(--c);
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--c) 45%, transparent));
  }

  .ach__tier-n {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.8125rem;
    color: #fff;
  }

  .ach__tier-l {
    font-size: 0.6875rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.55);
  }

  /* Başarım kartları */
  .ach__list {
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  .ach__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;
    border-radius: 18px;
    background: color-mix(in srgb, var(--c) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
  }

  .ach__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--c), color-mix(in srgb, var(--c) 55%, transparent));
    color: #fff;
  }

  .ach__body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .ach__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .ach__t {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
  }

  .ach__badge {
    padding: 0.0625rem 0.375rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--c) 15%, transparent);
    color: var(--c);
    font-size: 0.6875rem;
    font-weight: 800;
  }

  .ach__d {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.6);
  }

  .ach__state {
    color: var(--c);
  }

  .ach__item.is-locked {
    background: rgb(255 255 255 / 0.025);
    border-color: rgb(255 255 255 / 0.06);
  }

  .ach__item.is-locked .ach__icon {
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 20%, transparent);
    color: rgb(255 255 255 / 0.22);
  }

  .ach__item.is-locked .ach__t {
    color: rgb(255 255 255 / 0.55);
  }

  .ach__item.is-locked .ach__d {
    color: rgb(255 255 255 / 0.4);
  }

  .ach__item.is-locked .ach__state {
    color: rgb(255 255 255 / 0.18);
  }

  @container (max-width: 15.5rem) {
    .ach__tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
