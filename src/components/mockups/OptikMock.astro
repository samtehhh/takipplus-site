---
/**
 * Optik Çözüm: telefon dijital optik forma dönüşür, her sorunun süresi
 * ölçülür, sonunda rapor çıkar. Kamera ile tarama YOKTUR. Değerler örnektir.
 */
const opts = ['A', 'B', 'C', 'D', 'E'];
const rows = [
  { n: 1, mark: 'B', t: '0:48' },
  { n: 2, mark: 'D', t: '1:12' },
  { n: 3, mark: 'A', t: '0:35' },
  { n: 4, mark: '', t: '2:40', skipped: true },
  { n: 5, mark: 'C', t: '1:05' },
  { n: 6, mark: 'E', t: '0:57', live: true },
];
---

<div class="mock optik" data-animate>
  <div class="optik__head">
    <p class="optik__title">TYT Matematik</p>
    <p class="optik__clock num" aria-label="Geçen süre 7 dakika 17 saniye">07:17</p>
  </div>
  <ol class="optik__rows" role="list">
    {
      rows.map((r) => (
        <li class:list={['orow', { 'orow--live': r.live, 'orow--skip': r.skipped }]}>
          <span class="orow__n num">{r.n}</span>
          <span class="orow__opts" aria-hidden="true">
            {opts.map((o) => (
              <span class:list={['bubble', { 'bubble--on': o === r.mark }]}>{o}</span>
            ))}
          </span>
          <span class="orow__t num">{r.t}</span>
          <span class="sr-only">{r.mark ? `${r.n}. soru: ${r.mark} işaretlendi, ${r.t}` : `${r.n}. soru: boş, ${r.t}`}</span>
        </li>
      ))
    }
  </ol>
</div>

<style is:global>
  .optik {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
  }

  .optik__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .optik__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
  }

  .optik__clock {
    padding: 0.25rem 0.625rem;
    border-radius: 10px;
    background: rgb(45 212 191 / 0.14);
    color: var(--teal-400);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .optik__rows {
    display: grid;
    gap: 0.375rem;
    list-style: none;
  }

  .orow {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 14px;
    background: rgb(10 10 26 / 0.35);
    border: 1px solid transparent;
  }

  .orow--live {
    border-color: rgb(45 212 191 / 0.5);
    background: rgb(45 212 191 / 0.07);
  }

  .orow__n {
    font-size: 0.875rem;
    color: var(--text-2);
  }

  .orow__opts {
    display: flex;
    gap: 0.3rem;
  }

  .bubble {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-2);
  }

  .bubble--on {
    border-color: var(--violet-500);
    background: var(--violet-600);
    color: #fff;
  }

  .orow__t {
    font-size: 0.8125rem;
    color: var(--text-2);
  }

  .orow--skip .orow__t {
    color: var(--amber-500);
  }

  .orow--live .orow__t {
    color: var(--teal-400);
  }

  @media (prefers-reduced-motion: no-preference) {
    .motion .optik.is-in .orow--live .bubble--on {
      animation: bubble-pop 600ms var(--ease-spring) 400ms both;
    }
  }

  @keyframes bubble-pop {
    from {
      transform: scale(0.4);
      background: transparent;
      color: var(--text-2);
    }
  }

  @media (max-width: 22rem) {
    .bubble {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style>
