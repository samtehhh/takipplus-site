---
/**
 * Takip+ logosu: marka kitindeki düz uygulama karosu (assets/brand/kit/yks/svg/uygulama-karosu-duz.svg)
 * + uygulamadaki wordmark (Outfit 800, harf aralığı −0.2).
 * Kit kuralı: 64 px altında ışıltılı değil düz sürüm; header ve footer 32–40 px.
 */
import tileSvg from '../../assets/brand/kit/yks/svg/uygulama-karosu-duz.svg?raw';

let instance = 0;

interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
  /** Eski API: logo artık satır içi SVG olduğu için etkisiz */
  eager?: boolean;
}

const { size = 32, wordmark = true, class: cls } = Astro.props;

// Kitteki SVG'nin kendisi, satır içi (ayrı istek yok). Aynı sayfada birden çok logo
// olduğunda gradyan kimlikleri çakışmasın diye her kopyaya ayrı ek verilir.
const uid = `tg${++instance}`;
const svg = tileSvg
  .replace(/<title>.*?<\/title>/, '')
  .replace(/ width="512" height="512"/, ` width="${size}" height="${size}" class="logo__mark" aria-hidden="true" focusable="false"`)
  .replace(/id="tg"/g, `id="${uid}"`)
  .replace(/url\(#tg\)/g, `url(#${uid})`);
---

<span class:list={['logo', cls]} style={`--logo-size:${size}px`}>
  <Fragment set:html={svg} />
  {wordmark && <span class="logo__word">Takip+</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo :global(.logo__mark) {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--logo-size) * 0.66);
    letter-spacing: var(--tracking-wordmark);
    line-height: 1;
  }
</style>
