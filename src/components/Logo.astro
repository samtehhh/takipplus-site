---
/**
 * Takip+ logosu: orijinal uygulama logosu (assets/brand/takipplus-logo-512.png)
 * + uygulamadaki wordmark (Outfit 800, harf aralığı −0.2).
 */
import { Image } from 'astro:assets';
import logo from '../../assets/brand/takipplus-logo-512.png';

interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
  /** Hero gibi ilk ekranda görünen yerlerde true */
  eager?: boolean;
}

const { size = 32, wordmark = true, class: cls, eager = false } = Astro.props;
---

<span class:list={['logo', cls]} style={`--logo-size:${size}px`}>
  <Image
    class="logo__mark"
    src={logo}
    alt=""
    width={size}
    height={size}
    densities={[1, 2, 3]}
    format="webp"
    quality={90}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {wordmark && <span class="logo__word">Takip+</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo :global(.logo__mark) {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--logo-size) * 0.66);
    letter-spacing: var(--tracking-wordmark);
    line-height: 1;
  }
</style>
