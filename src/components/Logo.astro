---
/**
 * Takip+ logosu: marka kitindeki düz uygulama karosu (assets/brand/kit/yks/svg/uygulama-karosu-duz.svg)
 * + uygulamadaki wordmark (Outfit 800, harf aralığı −0.2).
 * Kit kuralı: 64 px altında ışıltılı değil düz sürüm; header ve footer 32–40 px.
 */
import tile from '../../assets/brand/kit/yks/svg/uygulama-karosu-duz.svg';

interface Props {
  size?: number;
  wordmark?: boolean;
  class?: string;
  /** Hero gibi ilk ekranda görünen yerlerde true */
  eager?: boolean;
}

const { size = 32, wordmark = true, class: cls, eager = false } = Astro.props;
---

<span class:list={['logo', cls]} style={`--logo-size:${size}px`}>
  <img
    class="logo__mark"
    src={tile.src}
    alt=""
    width={size}
    height={size}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {wordmark && <span class="logo__word">Takip+</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  .logo__mark {
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
  }

  .logo__word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--logo-size) * 0.66);
    letter-spacing: var(--tracking-wordmark);
    line-height: 1;
  }
</style>
