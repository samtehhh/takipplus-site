---
interface Props {
  items: { q: string; a: string }[];
  name?: string;
}
const { items, name = 'sss' } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item" name={name}>
        <summary class="faq__q">
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a" set:html={item.a} />
      </details>
    ))
  }
</div>

<style is:global>
  .faq {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
    interpolate-size: allow-keywords;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline-offset: 2px;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgb(148 163 184 / 0.08);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    translate: -50% -50%;
    transition: rotate var(--dur-3) var(--ease-out);
  }

  .faq__icon::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__icon::after {
    rotate: 0deg;
  }

  .faq__a {
    padding-bottom: var(--space-5);
    color: var(--text-2);
    max-width: var(--measure);
  }

  .faq__a p + p {
    margin-top: var(--space-3);
  }

  .faq__a a {
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--dur-3) var(--ease-out),
        content-visibility var(--dur-3) allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media (hover: hover) {
    .faq__q:hover .faq__icon {
      background: rgb(148 163 184 / 0.16);
    }
  }
</style>
