---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { liveProducts } from '../data/products';
import { legalLinks } from '../data/nav';

interface Props {
  ctaHref: string;
  currentPath: string;
}

const { ctaHref, currentPath } = Astro.props;

const nav = [
  ...liveProducts.map((p) => ({ href: `/${p.slug}`, label: p.name })),
  { href: '/hakkimizda', label: 'Hakkımızda' },
  { href: '/marka', label: 'Marka' },
  { href: '/iletisim', label: 'İletişim' },
];
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="container site-header__row">
    <a class="site-header__brand tap" href="/" aria-label="Takip+ ana sayfa">
      <Logo size={32} eager />
    </a>

    <nav class="site-header__nav" aria-label="Ana menü">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={ctaHref} class="site-header__cta" track="cta_header">Erken erişime katıl</Button>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-open
      >
        <span class="sr-only">Menüyü aç</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="goalbar" aria-hidden="true" data-goalbar>
    <span class="goalbar__track"><span class="goalbar__fill"></span></span>
    <span class="goalbar__run"><span class="goalbar__tip"></span></span>
    <span class="goalbar__goal"></span>
  </div>
</header>

<dialog id="site-menu" class="menu" aria-label="Menü" data-menu>
  <div class="menu__inner">
    <div class="menu__top">
      <a class="tap" href="/" aria-label="Takip+ ana sayfa"><Logo size={32} eager /></a>
      <button class="menu__close" type="button" data-menu-close>
        <span class="sr-only">Menüyü kapat</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
    <nav aria-label="Mobil menü">
      <ul class="menu__links">
        <li><a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Ana sayfa</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__bottom">
      <Button href={ctaHref} size="lg" track="cta_menu">Erken erişime katıl</Button>
      <ul class="menu__legal">
        {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    padding-top: env(safe-area-inset-top);
    background: transparent;
    transition: background-color var(--dur-3) var(--ease-out);
  }

  /* Sayfa başında şeffaf (hero gökyüzü altta görünür); kaydırınca gece camı */
  :global(.is-scrolled) .site-header {
    background: rgb(14 8 40 / 0.86);
  }

  @supports (backdrop-filter: blur(1px)) {
    :global(.is-scrolled) .site-header {
      background: rgb(14 8 40 / 0.66);
      backdrop-filter: saturate(1.5) blur(16px);
      -webkit-backdrop-filter: saturate(1.5) blur(16px);
    }
  }

  /* ---------- Hedef çizgisi: kaydırdıkça HEDEF'e ilerler ----------
   * Destekleyen tarayıcılarda CSS scroll-timeline; diğerlerinde site.ts --p yazar.
   */
  .goalbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }

  :global(.is-scrolled) .goalbar {
    opacity: 1;
  }

  .goalbar__track {
    position: absolute;
    inset: 0 16px 0 0;
    overflow: hidden;
  }

  .goalbar__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(139 92 246 / 0.15), #8b5cf6 35%, #a855f7 75%, #e056fd);
    transform: translateX(calc((var(--p, 0) - 1) * 100%));
  }

  /* Uç noktası: tam genişlikteki "koşucu" kutunun sağ kenarında; kutu kayar */
  .goalbar__run {
    position: absolute;
    inset: 0 16px 0 0;
    transform: translateX(calc((var(--p, 0) - 1) * 100%));
  }

  .goalbar__tip {
    position: absolute;
    right: 0;
    top: 50%;
    width: 8px;
    height: 8px;
    translate: 50% -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 2px #e056fd,
      0 0 12px 2px rgb(224 86 253 / 0.8);
  }

  /* HEDEF: sağ uçta turkuaz kesik işaret */
  .goalbar__goal {
    position: absolute;
    right: 2px;
    top: 50%;
    width: 12px;
    height: 2px;
    translate: 0 -50%;
    background: repeating-linear-gradient(90deg, #2dd4bf 0 3px, transparent 3px 5px);
  }

  :global(.is-goal) .goalbar__tip {
    background: #2dd4bf;
    box-shadow:
      0 0 0 2px #5eead4,
      0 0 14px 3px rgb(45 212 191 / 0.8);
  }

  /* Uzun yazımlar ve zaman çizelgesi ayrı kuralda: küçültücü bunları
     "animation" kısaltmasına birleştirince Chrome bildirimi geçersiz sayıyor. */
  @supports (animation-timeline: scroll()) {
    .goalbar__fill,
    .goalbar__run {
      animation-name: goalbar-run;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    .goalbar__tip {
      animation-name: goalbar-tip;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }

    .goalbar .goalbar__fill,
    .goalbar .goalbar__run,
    .goalbar .goalbar__tip {
      animation-timeline: scroll(root block);
    }
  }

  @keyframes goalbar-run {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Sona varınca uç turkuaza döner: HEDEF'e ulaşıldı */
  @keyframes goalbar-tip {
    0%,
    96% {
      background: #fff;
      box-shadow:
        0 0 0 2px #e056fd,
        0 0 12px 2px rgb(224 86 253 / 0.8);
    }
    100% {
      background: #2dd4bf;
      box-shadow:
        0 0 0 2px #5eead4,
        0 0 14px 3px rgb(45 212 191 / 0.8);
    }
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 64px;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: 10px;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__actions :global(.site-header__cta) {
    display: none;
  }

  .menu-toggle,
  .menu__close {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -12px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--text);
  }

  .menu-toggle:active,
  .menu__close:active {
    background: rgb(148 163 184 / 0.14);
  }

  @media (min-width: 30rem) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
      --btn-h: 44px;
      padding-inline: 1.125rem;
      font-size: 0.9375rem;
    }
  }

  @media (min-width: 60rem) {
    .site-header__row {
      height: 72px;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__nav ul {
      display: flex;
      gap: var(--space-1);
      list-style: none;
    }

    .site-header__nav a {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.875rem;
      border-radius: 999px;
      color: rgb(248 250 252 / 0.72);
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: 600;
      text-decoration: none;
      transition:
        color var(--dur-2) var(--ease-out),
        background-color var(--dur-2) var(--ease-out);
    }

    .site-header__nav a[aria-current='page'] {
      color: var(--text);
      background: rgb(255 255 255 / 0.08);
    }

    .menu-toggle {
      display: none;
    }
  }

  @media (min-width: 60rem) and (hover: hover) {
    .site-header__nav a:hover {
      color: var(--text);
    }
  }

  /* ---------- Mobil menü ---------- */
  .menu {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
    overscroll-behavior: contain;
  }

  .menu::backdrop {
    background: var(--bg);
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: env(safe-area-inset-top) var(--gutter) calc(var(--space-5) + env(safe-area-inset-bottom));
    background:
      radial-gradient(60rem 30rem at 10% -10%, rgb(139 92 246 / 0.32), transparent 60%),
      radial-gradient(30rem 20rem at 100% 100%, rgb(224 86 253 / 0.12), transparent 70%),
      var(--bg);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .menu__top a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .menu__links {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-6);
    list-style: none;
  }

  .menu__links a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .menu__links a[aria-current='page'] {
    color: var(--violet-400);
  }

  .menu__links a:active {
    color: var(--violet-300);
  }

  .menu__bottom {
    display: grid;
    gap: var(--space-5);
    margin-top: auto;
    padding-top: var(--space-7);
  }

  .menu__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
  }

  .menu__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu__inner {
      animation: menu-in var(--dur-3) var(--ease-out);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
