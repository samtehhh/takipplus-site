---
import Logo from './Logo.astro';
import { liveProducts, statusLabel } from '../data/products';
import { legalLinks, companyLinks, toolLinks } from '../data/nav';
import { site, contactEmail } from '../config/site';

const socials = [
  ['instagram', 'Instagram'],
  ['x', 'X'],
  ['tiktok', 'TikTok'],
  ['youtube', 'YouTube'],
  ['linkedin', 'LinkedIn'],
]
  .map(([k, label]) => ({ label, href: site.social[k as keyof typeof site.social] }))
  .filter((s) => s.href);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo size={36} />
        <p class="site-footer__promise">Kendi ilerlemeni sen yönet.</p>
        <a class="site-footer__mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </div>

      <nav aria-label="Ürünler">
        <h2 class="site-footer__title">Ürünler</h2>
        <ul>
          {
            liveProducts.map((p) => (
              <li>
                <a href={`/${p.slug}`}>{p.name}</a>
                <span class="site-footer__status">{statusLabel[p.status]}</span>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Araçlar">
        <h2 class="site-footer__title">Araçlar</h2>
        <ul>
          {toolLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Takip+">
        <h2 class="site-footer__title">Takip+</h2>
        <ul>
          {companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {socials.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Yasal">
        <h2 class="site-footer__title">Yasal</h2>
        <ul>
          {legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="site-footer__base">
      <p>© {year} Takip+ (Takip Plus), {site.founder}</p>
      <p>Takip+ YKS, ÖSYM ya da YÖK ile bağlantılı resmî bir uygulama değildir.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-8);
    padding-block: var(--space-8) var(--space-7);
    background:
      radial-gradient(50rem 18rem at 15% 0%, rgb(139 92 246 / 0.12), transparent 70%),
      linear-gradient(180deg, var(--night-850), var(--night-950) 80%);
  }

  /* Üst kenar: logo gradyanında ince çizgi */
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(139 92 246 / 0.6) 30%, rgb(224 86 253 / 0.5) 70%, transparent);
  }

  .site-footer__promise {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: start;
  }

  .site-footer__mail {
    font-family: var(--font-body);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .site-footer__title {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0;
  }

  .site-footer ul {
    list-style: none;
  }

  .site-footer li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.5rem;
  }

  .site-footer nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .site-footer__status {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .site-footer__base {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  @media (min-width: 48rem) {
    .site-footer__base {
      display: flex;
      justify-content: space-between;
      gap: var(--space-5);
    }
  }

  @media (hover: hover) {
    .site-footer nav a:hover {
      color: var(--text);
    }
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
