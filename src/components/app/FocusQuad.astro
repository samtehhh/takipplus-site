---
/**
 * Günün Odağı dörtlüsü: uygulamadaki hedef kartlarının (Saat, Soru, Video, Konu)
 * birebir kopyası. Rakamlar CSS sayaçlarıyla sıfırdan sayılır (JS gerekmez),
 * çubuklar dolar. Süs öğesidir; anlamı yanındaki metin ve görselin alt metni taşır.
 * Ölçüler en yakın kapsayıcının (Device) genişliğine göre cqw.
 */
interface Props {
  /** intro: sayfa açılışında oynar. scroll: görünür olunca. */
  animate?: 'intro' | 'scroll';
  class?: string;
}

const { animate = 'scroll', class: cls } = Astro.props;

const cards = [
  { k: 'saat', label: 'SAAT', whole: 4, frac: 2, total: '/8', p: 0.525 },
  { k: 'soru', label: 'SORU', whole: 80, total: '/100', p: 0.8 },
  { k: 'video', label: 'VİDEO', whole: 5, total: '/10', p: 0.5 },
  { k: 'konu', label: 'KONU', whole: 5, total: '/5', p: 1 },
];

const icons: Record<string, string> = {
  saat: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/>',
  soru: '<path d="M4 7h10"/><path d="M4 12h8"/><path d="M4 17h5"/><path d="M14 19l6-6-2-2-6 6v2z"/>',
  video: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5v7l6-3.5z"/>',
  konu: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 21.5V5.5"/>',
};
---

<div
  class:list={['fq', { 'fq--intro': animate === 'intro' }, cls]}
  aria-hidden="true"
  data-animate={animate === 'scroll' ? '' : undefined}
>
  {
    cards.map((c, i) => (
      <div class:list={['fq__card', `fq__card--${c.k}`]} style={`--i:${i};--p:${c.p};--w:${c.whole};--f:${c.frac ?? 0}`}>
        <span class="fq__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons[c.k]} />
        </span>
        <span class:list={['fq__value', { 'fq__value--frac': c.frac !== undefined }]}>
          <span class="fq__total">{c.total}</span>
        </span>
        <span class="fq__label">{c.label}</span>
        <span class="fq__bar"><span></span></span>
      </div>
    ))
  }
</div>

<style is:global>
  @property --fq-w {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  @property --fq-f {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .fq {
    display: flex;
    gap: 2.4cqw;
    font-family: var(--font-display);
  }

  .fq__card {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
    padding: 3.8cqw 3.4cqw 4.1cqw;
    border-radius: 6.2cqw;
    background: linear-gradient(160deg, var(--c1), var(--c2));
    box-shadow:
      0 0 0 1.5px var(--edge) inset,
      0 22px 44px rgb(5 2 25 / 0.6),
      0 0 24px var(--halo);
  }

  .fq__card--saat {
    --c1: #3b2a7a;
    --c2: #211a48;
    --edge: rgb(139 92 246 / 0.7);
    --halo: rgb(139 92 246 / 0.2);
    --tile: rgb(139 92 246 / 0.3);
    --ink: #c4b5fd;
    --tone: #a78bfa;
    --bar: #8b5cf6;
  }

  .fq__card--soru {
    --c1: #134e4a;
    --c2: #0f2a33;
    --edge: rgb(45 212 191 / 0.65);
    --halo: rgb(45 212 191 / 0.17);
    --tile: rgb(45 212 191 / 0.25);
    --ink: #5eead4;
    --tone: #2dd4bf;
    --bar: #2dd4bf;
  }

  .fq__card--video {
    --c1: #4a3312;
    --c2: #2a1f10;
    --edge: rgb(245 158 11 / 0.65);
    --halo: rgb(245 158 11 / 0.16);
    --tile: rgb(245 158 11 / 0.25);
    --ink: #fbbf24;
    --tone: #fbbf24;
    --bar: #f59e0b;
  }

  .fq__card--konu {
    --c1: #4c1d24;
    --c2: #2a1219;
    --edge: rgb(239 68 68 / 0.6);
    --halo: rgb(239 68 68 / 0.16);
    --tile: rgb(239 68 68 / 0.25);
    --ink: #f87171;
    --tone: #f87171;
    --bar: #ef4444;
  }

  .fq__icon {
    display: grid;
    place-items: center;
    width: 9cqw;
    height: 9cqw;
    border-radius: 3.1cqw;
    background: var(--tile);
    color: var(--ink);
  }

  .fq__icon svg {
    width: 4.8cqw;
    height: 4.8cqw;
  }

  .fq__value {
    font-size: max(13px, 7.2cqw);
    font-weight: 800;
    line-height: 1;
    color: #fff;
    letter-spacing: -0.01em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    /* Kayıtlı özellikler kalıtılmaz: sayaç değeri bu öğenin kendisinde */
    --fq-w: var(--w);
    --fq-f: var(--f);
    counter-reset: fqw var(--fq-w) fqf var(--fq-f);
  }

  .fq__value::before {
    content: counter(fqw);
  }

  .fq__value--frac::before {
    content: counter(fqw) '.' counter(fqf);
  }

  .fq__label {
    font-size: max(8px, 3.3cqw);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--tone);
  }

  .fq__bar {
    height: 1.4cqw;
    min-height: 3px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }

  .fq__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--bar);
    transform-origin: left;
    transform: scaleX(var(--p));
  }

  @media (prefers-reduced-motion: no-preference) {
    .motion .fq[data-animate]:not(.is-in) .fq__card {
      opacity: 0;
    }

    .fq--intro .fq__card,
    .fq.is-in .fq__card {
      animation: fq-pop 600ms var(--ease-spring) both;
      animation-delay: calc(500ms + var(--i) * 90ms);
    }

    .fq--intro .fq__value,
    .fq.is-in .fq__value {
      animation: fq-count 1100ms var(--ease-out) both;
      animation-delay: calc(650ms + var(--i) * 90ms);
    }

    .fq--intro .fq__bar span,
    .fq.is-in .fq__bar span {
      animation: fq-fill 1100ms var(--ease-out) both;
      animation-delay: calc(700ms + var(--i) * 90ms);
    }
  }

  @keyframes fq-pop {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.92);
    }
  }

  @keyframes fq-count {
    from {
      --fq-w: 0;
      --fq-f: 0;
    }
  }

  @keyframes fq-fill {
    from {
      transform: scaleX(0);
    }
  }
</style>
