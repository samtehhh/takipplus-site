---
/**
 * Sitenin tek ikon seti (BRAND.md §6): 24×24 ızgara, 1.8 px çizgi, yuvarlak uç,
 * dolgusuz. Sekme ikonları uygulamanın alt menüsündeki Material ikonlarının
 * çizgi karakterini izler.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Görünür bir metnin yanındaysa süs: aria-hidden */
  label?: string;
}

const paths: Record<string, string> = {
  bugun:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/>',
  konular: '<path d="M3 5.5c2.6-1 5.6-1 9 1.3 3.4-2.3 6.4-2.3 9-1.3V19c-2.6-1-5.6-1-9 1.3C8.6 18 5.6 18 3 19z"/><path d="M12 6.8v13.5"/>',
  calisma: '<circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.5v4l2.6 1.8M9.5 2.5h5M19 6.5l1.3-1.3"/>',
  denemeler: '<path d="M3 17l5.5-5.5 4 4L20 8"/><path d="M15 8h5v5"/><path d="M5 4.5v3M3.5 6h3"/>',
  hedef:
    '<path d="M7 4h10v4.5a5 5 0 0 1-10 0z"/><path d="M7 6H4.5a2.5 2.5 0 0 0 2.6 3.4M17 6h2.5a2.5 2.5 0 0 1-2.6 3.4"/><path d="M12 13.5V17M8.5 20.5h7M9.5 20.5c0-1.9 1.1-3.5 2.5-3.5s2.5 1.6 2.5 3.5"/>',
  planlar: '<rect x="3.5" y="4.5" width="17" height="16" rx="3"/><path d="M3.5 9.5h17M8 2.5v4M16 2.5v4M8 13.5h2M14 13.5h2M8 17h2"/>',
  sosyal:
    '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.3 3-5.2 6-5.2s5.4 1.9 6 5.2"/><path d="M15.5 5.6a3 3 0 0 1 0 5.8M17.5 14.6c1.8.6 3 2.3 3.5 4.9"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  pause: '<path d="M9 6v12M15 6v12"/>',
  play: '<path d="M8 5.5v13l10.5-6.5z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>',
  tablet: '<rect x="4.5" y="2.5" width="15" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  widget: '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="17" height="7" rx="2"/>',
  book: '<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19"/><path d="M9 7.5h6"/>',
  medal: '<circle cx="12" cy="14.5" r="5.5"/><path d="M8.5 10.3L5.5 3h4l2.5 5.5M15.5 10.3L18.5 3h-4l-1.6 3.5"/><path d="M12 12.3v4.4M10 14.5h4"/>',
};

const { name, size = 24, class: cls, label } = Astro.props;
const body = paths[name];
if (!body) throw new Error(`AppIcon: bilinmeyen ikon "${name}"`);
---

<svg
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={body}
/>
