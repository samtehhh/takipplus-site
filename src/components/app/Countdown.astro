---
/**
 * Sınava kalan süre: uygulamanın Hedef&Net sekmesindeki sayaçla aynı biçim
 * (GÜN · SAAT · DAKİKA · SANİYE). Sayılar site.ts tarafından her saniye
 * güncellenir; JS yoksa yalnızca tarih satırı görünür.
 */
interface Props {
  iso: string;
  label: string;
  dateText: string;
  note: string;
}

const { iso, label, dateText, note } = Astro.props;
const units = [
  ['d', 'GÜN'],
  ['h', 'SAAT'],
  ['m', 'DAKİKA'],
  ['s', 'SANİYE'],
];
---

<div class="cd" data-countdown={iso}>
  <div class="cd__tiles" aria-hidden="true">
    {
      units.map(([k, l]) => (
        <span class="cd__tile">
          <b data-cd={k}>00</b>
          <small>{l}</small>
        </span>
      ))
    }
  </div>
  <p class="sr-only" data-cd-sr></p>
  <p class="cd__meta">
    <strong>{label}: {dateText}, saat 10.15.</strong>
    {note}
  </p>
</div>

<style>
  .cd {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
  }

  .cd__tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 0.3rem + 1vw, 1rem);
    width: min(100%, 40rem);
  }

  /* JS yoksa sayaç yok, yalnızca tarih; JS varsa ilk hesaplamaya kadar yer tutar */
  :global(html:not(.js)) .cd__tiles {
    display: none;
  }

  .cd:not(.is-ready) .cd__tiles {
    visibility: hidden;
  }

  .cd__tile {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: clamp(0.875rem, 0.6rem + 1.4vw, 1.5rem) 0.25rem;
    border-radius: clamp(16px, 12px + 1vw, 24px);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
    background-color: rgb(20 14 54 / 0.7);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12) inset,
      0 24px 50px -24px rgb(5 2 25 / 0.9);
  }

  .cd__tile b {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.3rem + 3.6vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .cd__tile small {
    font-family: var(--font-display);
    font-size: clamp(0.625rem, 0.55rem + 0.3vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--violet-300);
  }

  .cd__meta {
    max-width: 34rem;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-2);
  }

  .cd__meta strong {
    display: block;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
  }
</style>
