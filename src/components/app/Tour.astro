---
/**
 * Uygulama turu: altı sekme, her sekmede uygulamadan kısa bir klip (public/videos).
 * Sekmeler uygulamanın alt menüsündeki gibi; seçili sekme mor→turkuaz gradyanla dolar,
 * altındaki çubuk klibin ilerlemesini gösterir. JS: site.ts (ARIA sekme deseni, ok
 * tuşları, video oynatma ve sıradaki sekmeye geçiş). Klipler yalnızca bölüm görünürken
 * ve hareket azaltılmamışsa kendiliğinden oynar; "Turu durdur" düğmesi her zaman var.
 * JS yoksa: ilk sekmenin kapak karesi ve bütün sekme açıklamaları liste olarak görünür.
 */
import Device from './Device.astro';
import AppIcon from './AppIcon.astro';
import type { TabIcon } from '../../data/product-content/yks';
import type { ScreenName } from '../../data/screens';

interface Props {
  id: string;
  title: string;
  lead: string;
  tabs: { id: string; name: string; icon: TabIcon; screen: ScreenName; video?: string; text: string }[];
}

const { id, title, lead, tabs } = Astro.props;
---

<section class="section tour" id={id} aria-labelledby={`${id}-title`} data-tour>
  <div class="container tour__grid">
    <div class="tour__head" data-reveal>
      <h2 class="h2" id={`${id}-title`}>{title}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class="tour__visual">
      <Device
        screens={tabs.map((t) => t.screen)}
        videos={tabs.map((t) => t.video)}
        sizes="(min-width: 80rem) 360px, (min-width: 64rem) 320px, (min-width: 48rem) 38vw, 64vw"
        class="tour__device"
      />
    </div>

    <div class="tour__controls">
      <div class="tour__tabs" role="tablist" aria-label="Uygulamanın sekmeleri" data-tour-tabs>
        {
          tabs.map((t, i) => (
            <button
              class:list={['tour__tab', { 'is-active': i === 0 }]}
              type="button"
              role="tab"
              id={`${id}-tab-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`${id}-panel`}
              tabindex={i === 0 ? 0 : -1}
              data-tour-tab={i}
            >
              <AppIcon name={t.icon} size={22} />
              <span class="tour__name">{t.name}</span>
              <span class="tour__bar" aria-hidden="true">
                <i></i>
              </span>
            </button>
          ))
        }
      </div>

      <div class="tour__panel" id={`${id}-panel`} role="tabpanel" aria-labelledby={`${id}-tab-${tabs[0].id}`}>
        {
          tabs.map((t, i) => (
            <p class:list={['tour__text', { 'is-active': i === 0 }]} data-tour-text={i}>
              <strong>{t.name}.</strong> {t.text}
            </p>
          ))
        }
      </div>

      <button class="tour__play" type="button" data-tour-play hidden>
        <span class="tour__play-ic" aria-hidden="true">
          <AppIcon name="pause" size={18} class="tour__ic-pause" />
          <AppIcon name="play" size={18} class="tour__ic-play" />
        </span>
        <span data-tour-play-label>Turu durdur</span>
      </button>
    </div>
  </div>
</section>

<style>
  .tour {
    overflow-x: clip;
  }

  .tour__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-areas:
      'head'
      'visual'
      'controls';
  }

  .tour__head {
    grid-area: head;
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .tour__visual {
    grid-area: visual;
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
    padding-block: var(--space-5);
  }

  .tour__visual::before {
    content: '';
    position: absolute;
    inset: 8% 0;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.42), rgb(224 86 253 / 0.1) 60%, transparent);
  }

  .tour__visual :global(.tour__device) {
    width: min(64vw, 300px);
  }

  /* Seçili olmayan ekranlar tur yaklaşana kadar çizilmez, dolayısıyla inmez */
  .tour:not(:global(.is-armed)) :global(.device__shot:not(.is-active)) {
    display: none;
  }

  .tour__controls {
    grid-area: controls;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .tour__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .tour__tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 72px;
    padding: 0.625rem 0.25rem 0.75rem;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.04);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.09) inset;
    color: var(--text-2);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .tour__tab:active {
    transform: scale(0.97);
  }

  /* Uygulamadaki seçili sekme: mor → turkuaz */
  .tour__tab.is-active {
    color: #fff;
    background: linear-gradient(140deg, #8b5cf6 0%, #6366f1 45%, #2dd4bf 100%);
    box-shadow:
      0 10px 26px -10px rgb(139 92 246 / 0.8),
      0 1px 0 rgb(255 255 255 / 0.3) inset;
  }

  .tour__name {
    white-space: nowrap;
  }

  .tour__bar {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: 0.4rem;
    height: 2px;
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
  }

  /* Klibin ilerlemesi: site.ts --tp'yi (0–1) her karede yazar */
  .tour__bar i {
    display: block;
    height: 100%;
    background: rgb(255 255 255 / 0.9);
    transform-origin: left;
    transform: scaleX(var(--tp, 0));
  }

  :global(.tour.is-playing) .tour__tab.is-active .tour__bar {
    opacity: 1;
    background: rgb(255 255 255 / 0.25);
  }

  .tour__panel {
    min-height: 6.5em;
  }

  .tour__text {
    color: var(--text-2);
    font-size: var(--text-md);
    line-height: 1.55;
    max-width: 34rem;
  }

  .tour__text strong {
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
  }

  /* JS yoksa bütün açıklamalar sırayla görünür; JS varsa yalnızca seçili olan */
  .tour__text + .tour__text {
    margin-top: var(--space-3);
  }

  :global(.js) .tour__text:not(.is-active) {
    display: none;
  }

  :global(.js) .tour__text + .tour__text {
    margin-top: 0;
  }

  .tour__play {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.875rem 0 0.625rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: 0 0 0 1px var(--line-strong) inset;
    color: var(--text-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .tour__play[hidden] {
    display: none;
  }

  .tour__play-ic {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--text);
  }

  .tour__play :global(.tour__ic-play) {
    display: none;
  }

  .tour__play[aria-pressed='true'] :global(.tour__ic-play) {
    display: block;
  }

  .tour__play[aria-pressed='true'] :global(.tour__ic-pause) {
    display: none;
  }

  @media (hover: hover) {
    .tour__tab:not(.is-active):hover {
      color: var(--text);
      background: rgb(255 255 255 / 0.08);
    }

    .tour__play:hover {
      color: var(--text);
    }
  }

  @media (min-width: 48rem) {
    /* Sol sütun telefonun yanında dikey olarak ortalanır */
    .tour__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '. visual'
        'head visual'
        'controls visual'
        '. visual';
      column-gap: var(--space-8);
      row-gap: var(--space-6);
      align-items: start;
    }

    .tour__visual {
      align-self: center;
    }

    .tour__visual :global(.tour__device) {
      width: min(38vw, 320px);
    }
  }

  /* Geniş ekranda telefonlar büyür: küçük çerçevede 720 px'lik ekranın yazıları minicik kalıyordu */
  @media (min-width: 80rem) {
    .tour__visual :global(.tour__device) {
      width: 360px;
    }
  }

  @media (min-width: 64rem) {
    .tour__grid {
      column-gap: var(--space-9);
    }

    .tour__tab {
      min-height: 84px;
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tour__tab {
      transition: none;
    }
  }
</style>
