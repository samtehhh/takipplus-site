---
import '../styles/fonts.css';
import '../styles/global.css';
import outfitLatin from '../assets/fonts/outfit-latin.woff2?url';
import outfitTr from '../assets/fonts/outfit-tr.woff2?url';
import interLatin from '../assets/fonts/inter-latin.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../config/site';
import { products } from '../data/products';
import { breadcrumbLd } from '../lib/jsonld';

export interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  /** Kanonik yol, örn. "/yks". Ana sayfa için "/". */
  path: string;
  /** public/og/<ogImage>.png */
  ogImage?: string;
  ogAlt?: string;
  jsonLd?: object[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Ürün sayfalarında vurgu rengi. */
  accent?: { base: string; deep: string };
  /** Sayfanın bekleme listesi formuna giden bağlantı. */
  ctaHref?: string;
  /** Mobil sabit CTA çubuğunu göster. */
  stickyCta?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'default',
  ogAlt = 'Takip+ — Kendi ilerlemeni sen yönet.',
  jsonLd = [],
  breadcrumbs,
  noindex = false,
  accent,
  ctaHref = '/#erken-erisim',
  stickyCta = false,
} = Astro.props;

const canonical = new URL(path, site.url).href.replace(/\/$/, path === '/' ? '/' : '');
const ogUrl = new URL(`/og/${ogImage}.png`, site.url).href;
const fullTitle = title.includes('Takip+') ? title : `${title} | Takip+`;

const ld = [...jsonLd];
if (breadcrumbs?.length) ld.push(breadcrumbLd(breadcrumbs));

const releasedIos = products.find((p) => p.released && p.stores.appStoreId);
const accentStyle = accent
  ? `--accent:${accent.base};--accent-deep:${accent.deep};`
  : undefined;
---

<!doctype html>
<html lang="tr" style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitTr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />
    <meta name="apple-mobile-web-app-title" content="Takip+" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {releasedIos && <meta name="apple-itunes-app" content={`app-id=${releasedIos.stores.appStoreId}`} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Takip+" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <Analytics />
  </head>
  <body data-sticky-cta={stickyCta ? '' : undefined}>
    <a class="skip-link" href="#icerik">İçeriğe atla</a>
    <Header ctaHref={ctaHref} currentPath={path} />
    <main id="icerik" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {
      stickyCta && (
        <div class="sticky-cta" data-sticky hidden>
          <a class="sticky-cta__link" href={ctaHref} data-track="cta_sticky">
            <span>Erken erişime katıl</span>
            <span class="sticky-cta__hint">Yayına çıkınca ilk sen öğren</span>
          </a>
        </div>
      )
    }
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }

  .sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-sticky);
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: rgb(15 23 42 / 0.92);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .sticky-cta[hidden] {
    display: block;
    visibility: hidden;
  }

  .sticky-cta.is-shown {
    visibility: visible;
    transform: none;
  }

  .sticky-cta__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.5rem 0.5rem 0.5rem 1.125rem;
    border-radius: var(--radius-md);
    background: var(--grad-primary);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .sticky-cta__hint {
    padding: 0.375rem 0.625rem;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.12);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  @media (max-width: 26rem) {
    .sticky-cta__link {
      justify-content: center;
      padding: 0.5rem 1rem;
    }

    .sticky-cta__hint {
      display: none;
    }
  }

  .sticky-cta__link:active {
    transform: scale(0.98);
  }

  /* Sabit çubuk görünürken sayfa sonu içeriği örtülmesin */
  body[data-sticky-cta] .site-footer {
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom));
  }

  @media (min-width: 48rem) {
    .sticky-cta {
      display: none !important;
    }

    body[data-sticky-cta] .site-footer {
      padding-bottom: var(--space-7);
    }
  }
</style>
