---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import ActivityMap from '../components/mockups/ActivityMap.astro';
import TodayMock from '../components/mockups/TodayMock.astro';
import { liveProducts, statusLabel } from '../data/products';
import { site } from '../config/site';
import { organizationLd, websiteLd } from '../lib/jsonld';

const values = [
  { t: 'Netlik', d: 'Nerede olduğunu ve hedefe ne kadar kaldığını tahmin etmezsin, görürsün.' },
  { t: 'Disiplin', d: 'Motivasyon gelip gider. Küçük, her gün tekrarlanan adımlar kalır.' },
  { t: 'Topluluk', d: 'Aynı yolda yürüyenlerle yarışmak ve yardımlaşmak işi kolaylaştırır.' },
  { t: 'Sahiplik', d: 'Planın, verin ve kararların senin. Uygulama sadece aracın.' },
];
---

<Base
  title="Takip+: Kendi ilerlemeni sen yönet"
  description="Takip+, sınava hazırlanan öğrenciler için çalışma ve takip uygulamaları geliştirir. İlk ürün Takip+ YKS için erken erişim listesi açık."
  path="/"
  ogImage="home"
  jsonLd={[organizationLd(), websiteLd()]}
  ctaHref="#erken-erisim"
  stickyCta
>
  <section class="h-hero" data-hero>
    <div class="glow" aria-hidden="true"></div>
    <div class="container h-hero__grid">
      <div class="h-hero__copy">
        <h1 class="display h-hero__title">Kendi ilerlemeni sen yönet.</h1>
        <p class="lead">
          Takip+, sınava hazırlanan öğrenciler için çalışma ve takip uygulamaları geliştiren bağımsız bir
          marka. İlk uygulamamız Takip+ YKS.
        </p>
        <div class="h-hero__actions">
          <Button href="#erken-erisim" size="lg" track="cta_hero">Erken erişime katıl</Button>
          <Button href="/yks" size="lg" variant="secondary">Takip+ YKS’yi incele</Button>
        </div>
      </div>
      <div class="h-hero__visual">
        <ActivityMap />
        <p class="sample-note">Örnek veri</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="neden-title">
    <div class="container manifesto">
      <div class="manifesto__copy" data-reveal>
        <p class="label">Neden Takip+</p>
        <h2 class="h2" id="neden-title">Sınava hazırlanmak bir proje. Projeyi yöneten de sensin.</h2>
        <p class="lead">
          Konu listeleri deftere, netler bir tabloya, çalışma saatleri bir başka uygulamaya dağılınca resmin
          bütünü kaybolur. Takip+ bu parçaları tek yerde toplar ve her gün sana şu soruyu cevaplatır:
          bugün neyi, ne kadar yaptım?
        </p>
      </div>
      <ul class="values" role="list">
        {
          values.map((v) => (
            <li class="value">
              <h3 class="value__t">{v.t}</h3>
              <p class="value__d">{v.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="urunler" aria-labelledby="urunler-title">
    <div class="container">
      <div class="section-head">
        <p class="label">Ürünler</p>
        <h2 class="h2" id="urunler-title">Her sınav için ayrı, hepsi aynı ailede.</h2>
      </div>

      <div class="products">
        {
          liveProducts.map((p) => (
            <a class="product" href={`/${p.slug}`} style={`--pc:${p.accent};--pcd:${p.accentDeep}`}>
              <div class="product__copy">
                <div class="product__meta">
                  <span class="product__status">{statusLabel[p.status]}</span>
                  <span class="product__platforms">Android ve iOS</span>
                </div>
                <h3 class="product__name">{p.name}</h3>
                <p class="product__tag">{p.tagline}</p>
                <span class="product__more">Ürünü incele</span>
              </div>
              <div class="product__visual" aria-hidden="true">
                <TodayMock compact />
              </div>
            </a>
          ))
        }

        <div class="product product--soon">
          <div class="product__copy">
            <h3 class="product__name">Yakında daha fazlası</h3>
            <p class="product__tag">
              Takip+ ailesi büyüyecek. Hazırlandığın sınav için bir Takip+ uygulaması görmek istiyorsan bize
              yaz; sıradaki ürünü belirlerken bu mesajları okuyoruz.
            </p>
            <a class="product__more" href="/iletisim">Fikrini ilet</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    site.socialProof.visible && site.socialProof.items.length > 0 && (
      <section class="section" aria-labelledby="kanit-title">
        <div class="container">
          <h2 class="h2" id="kanit-title">Kullananlar ne diyor</h2>
          <ul class="proof" role="list">
            {site.socialProof.items.map((i) => (
              <li>
                <blockquote>
                  <p>{i.quote}</p>
                  <footer>
                    {i.author} · {i.context}
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <WaitlistForm />
    </div>
  </section>
</Base>

<style>
  .h-hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-7) var(--section-y);
  }

  .h-hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .h-hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .h-hero__title {
    max-width: 11ch;
  }

  @media (min-width: 64rem) {
    .h-hero__title {
      max-width: 13ch;
    }
  }

  .h-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    width: 100%;
  }

  .h-hero__actions :global(.btn) {
    flex: 1 1 14rem;
  }

  .h-hero__visual {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
    width: 100%;
    max-width: 30rem;
  }

  .h-hero__visual :global(.amap) {
    width: 100%;
  }

  .manifesto {
    display: grid;
    gap: var(--space-7);
  }

  .manifesto__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 44rem;
  }

  .values {
    display: grid;
    gap: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .value {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .value__t {
    font-size: var(--text-lg);
  }

  .value__t::before {
    content: '+';
    margin-right: 0.5rem;
    color: var(--violet-400);
  }

  .value__d {
    color: var(--text-2);
  }

  .products {
    display: grid;
    gap: var(--space-4);
  }

  .product {
    position: relative;
    display: grid;
    gap: var(--space-6);
    overflow: hidden;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(40rem 22rem at 100% 0%, color-mix(in srgb, var(--pc) 28%, transparent), transparent 70%),
      var(--grad-card);
    border: 1px solid color-mix(in srgb, var(--pc) 35%, var(--line));
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-2);
    transition:
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  a.product:active {
    transform: scale(0.99);
  }

  .product__copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: start;
  }

  .product__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product__status,
  .product__platforms {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .product__status {
    background: color-mix(in srgb, var(--pc) 22%, transparent);
    color: var(--violet-300);
  }

  .product__platforms {
    background: rgb(148 163 184 / 0.1);
    color: var(--text-2);
  }

  .product__name {
    font-size: var(--text-2xl);
    font-weight: 800;
  }

  .product__tag {
    color: var(--text-2);
    max-width: 30rem;
  }

  .product__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--violet-400) 60%, transparent);
    text-underline-offset: 0.3em;
  }

  .product__visual {
    margin-inline: calc(var(--space-5) * -0.25);
  }

  .product__visual :global(.today) {
    rotate: -2deg;
  }

  .product--soon .product__name {
    font-size: var(--text-xl);
  }

  .product--soon {
    --pc: var(--ink-500);
    background: transparent;
    border: 1.5px dashed var(--line-strong);
    box-shadow: none;
  }

  .proof {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin-top: var(--space-6);
  }

  @media (hover: hover) {
    a.product:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-3);
    }
  }

  @media (min-width: 48rem) {
    .values {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-7);
    }

    .product {
      padding: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .h-hero {
      padding-top: var(--space-9);
    }

    .h-hero__grid {
      grid-template-columns: 1.2fr 1fr;
    }

    .manifesto {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: start;
    }

    .values {
      grid-template-columns: 1fr;
    }

    .product:not(.product--soon) {
      grid-template-columns: 1fr minmax(0, 26rem);
      align-items: center;
    }
  }

  @media (min-width: 80rem) {
    .products {
      grid-template-columns: 2fr 1fr;
    }

    .product:not(.product--soon) {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
