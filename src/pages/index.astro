---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import DeviceDuo from '../components/app/DeviceDuo.astro';
import Trajectory from '../components/app/Trajectory.astro';
import PhoneFan from '../components/app/PhoneFan.astro';
import StoreGallery from '../components/app/StoreGallery.astro';
import AppIcon from '../components/app/AppIcon.astro';
import { liveProducts, statusLabel } from '../data/products';
import { site } from '../config/site';
import { organizationLd, websiteLd } from '../lib/jsonld';
import glowMark from '../../assets/brand/kit/yks/png/isiltili-sembol-seffaf-1024.png';
import { Image } from 'astro:assets';

const values = [
  { t: 'Netlik', d: 'Nerede olduğunu ve hedefe ne kadar kaldığını tahmin etmezsin, görürsün.' },
  { t: 'Disiplin', d: 'Motivasyon gelip gider. Küçük, her gün tekrarlanan adımlar kalır.' },
  { t: 'Topluluk', d: 'Aynı yolda yürüyenlerle yarışmak ve yardımlaşmak işi kolaylaştırır.' },
  { t: 'Sahiplik', d: 'Planın, verin ve kararların senin. Uygulama sadece aracın.' },
];

const highlights = ['Günün Odağı', 'Optik Çözüm', 'Deneme analizi', 'Hedef&Net', 'Yapamadıklarım', 'Düellolar'];
---

<Base
  title="Takip+ (Takip Plus): Kendi ilerlemeni sen yönet"
  description="Takip+ (Takip Plus), YKS’ye hazırlanan öğrenciler için konu, deneme ve net takibini tek yerde toplayan uygulamalar geliştirir. İlk ürün: Takip+ YKS."
  path="/"
  ogImage="home"
  jsonLd={[organizationLd(), websiteLd()]}
  ctaHref="#erken-erisim"
  stickyCta
>
  <!-- 1. Hero: marka sözü + hedef ekranı -->
  <section class="hh" data-hero aria-labelledby="hh-title">
    <div class="hh__sky" aria-hidden="true"><span class="dotgrid"></span></div>
    <div class="container hh__grid">
      <div class="hh__copy">
        <h1 class="hh__title" id="hh-title">Kendi ilerlemeni sen yönet.</h1>
        <p class="lead hh__lead">
          Sınava hazırlanan öğrenciler için takip ve analiz uygulamaları. İlk uygulamamız Takip+ YKS.
        </p>
        <div class="hh__actions">
          <Button href="/yks" size="lg" arrow track="cta_hero">Takip+ YKS’yi keşfet</Button>
          <a class="hh__link" href="#erken-erisim">Erken erişime katıl</a>
        </div>
      </div>

      <div
        class="hh__visual stage"
        role="img"
        aria-label="Takip+ YKS iPad’de ve iPhone’da: iPad’de son 30 günün aktivite haritası ve Günün Odağı, iPhone’da hedef Boğaziçi Üniversitesi Endüstri Mühendisliği. Hedefe 18.180 sıra kaldı."
      >
        <Trajectory variant="hero" goal={64} animate="intro" class="hh__traj" />
        <DeviceDuo
          tablet="t-home-harita"
          phone="p-hedef-detay"
          tabletSizes="(min-width: 60rem) 470px, 74vw"
          phoneSizes="(min-width: 60rem) 200px, 32vw"
          eager
          class="hh__duo"
        >
          <div class="co hh__pill" aria-hidden="true">
            <span class="hh__pill-ic">
              <svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
            </span>
            <span>Hedefe <b>18.180</b> sıra kaldı</span>
          </div>
        </DeviceDuo>
      </div>
    </div>
  </section>

  <!-- 2. Tek uygulama: açılan yelpaze -->
  <section class="section one" aria-labelledby="one-title">
    <div class="container one__inner">
      <div class="one__head" data-reveal>
        <h2 class="h2" id="one-title">Bütün hazırlığın, tek uygulamada.</h2>
        <p class="lead">
          Konu listesi deftere, netler bir tabloya, çalışma süresi başka bir uygulamaya dağılmasın. Takip+ YKS
          hepsini aynı yerde toplar ve birbirine bağlar.
        </p>
      </div>
      <PhoneFan
        screens={['p-yap-analiz', 'p-ders-turkce', 'p-home-sayac', 'p-plan-takvimi', 'p-net-sihirbazi']}
        label="Takip+ YKS’den beş ekran: Yapamadıklarım analizi, TYT Türkçe net grafiği, YKS 2027 sayacı ve Günün Odağı, Plan Takvimi ve Net Sihirbazı."
      />
      <ul class="one__list" role="list">
        {highlights.map((h) => <li><span aria-hidden="true">+</span>{h}</li>)}
      </ul>
      <Button href="/yks" variant="secondary" arrow track="cta_home_features">Bütün özellikleri gör</Button>
    </div>
  </section>

  <!-- 3. Mağaza görselleri -->
  <StoreGallery
    id="gorseller"
    title="Takip+ YKS, on karede."
    lead="App Store ve Google Play için hazırladığımız görseller. Her biri uygulamanın bir parçasını anlatıyor; kaydırarak gez."
  />

  <!-- 4. Neden Takip+ -->
  <section class="section why defer" aria-labelledby="why-title">
    <div class="container why__grid">
      <div class="why__copy" data-reveal>
        <h2 class="h2" id="why-title">Sınava hazırlanmak bir proje. Projeyi yöneten de sensin.</h2>
        <p class="lead">
          Takip+ her gün sana tek bir soruyu cevaplatır: bugün neyi, ne kadar yaptım? Cevap rakam olunca
          nerede olduğunu tahmin etmezsin, görürsün.
        </p>
      </div>
      <dl class="values">
        {
          values.map((v) => (
            <div class="value">
              <dt>{v.t}</dt>
              <dd>{v.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 5. Ürün ailesi -->
  <section class="section defer" id="urunler" aria-labelledby="urunler-title">
    <div class="container">
      <div class="fam__head" data-reveal>
        <h2 class="h2" id="urunler-title">Her sınav için ayrı, hepsi aynı ailede.</h2>
      </div>
      <div class="fam">
        {
          liveProducts.map((p) => (
            <a class="fam__main" href={`/${p.slug}`}>
              <Image class="fam__mark" src={glowMark} alt="" width={160} height={160} loading="lazy" />
              <span class="fam__meta">
                <span class="fam__status">{statusLabel[p.status]}</span>
                <span class="fam__plat">Android, iOS ve iPad</span>
              </span>
              <span class="fam__name">{p.name}</span>
              <span class="fam__tag">{p.tagline}</span>
              <span class="fam__more">
                Ürünü incele
                <AppIcon name="plus" size={16} />
              </span>
            </a>
          ))
        }
        <div class="fam__soon">
          <p class="fam__soon-t">Yakında daha fazlası</p>
          <p class="muted">
            Takip+ ailesi büyüyecek. Hazırlandığın sınav için bir Takip+ uygulaması görmek istiyorsan bize yaz; sıradaki
            ürünü belirlerken bu mesajları okuyoruz.
          </p>
          <a class="fam__soon-link" href="/iletisim">Fikrini ilet</a>
        </div>
      </div>
    </div>
  </section>

  {
    site.socialProof.visible && site.socialProof.items.length > 0 && (
      <section class="section" aria-labelledby="kanit-title">
        <div class="container">
          <h2 class="h2" id="kanit-title">Kullananlar ne diyor</h2>
          <ul class="proof" role="list">
            {site.socialProof.items.map((i) => (
              <li>
                <blockquote>
                  <p>{i.quote}</p>
                  <footer>
                    {i.author}, {i.context}
                  </footer>
                </blockquote>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section defer">
    <div class="container">
      <WaitlistForm />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hh {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + var(--space-6)) 0 var(--space-8);
  }

  .hh__sky {
    position: absolute;
    inset: 0 0 -10rem;
    z-index: -1;
    background:
      radial-gradient(70% 45% at 50% 66%, rgb(139 92 246 / 0.5), transparent 70%),
      radial-gradient(35% 28% at 20% 30%, rgb(224 86 253 / 0.18), transparent 70%),
      var(--grad-sky);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
    mask-image: linear-gradient(180deg, #000 72%, transparent);
  }

  .hh__sky .dotgrid {
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 85%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 85%);
  }

  .hh__grid {
    display: grid;
    /* Tek sütun ekran genişliğini aşmasın (uzun kelime / büyük yazı sütunu genişletmesin) */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }

  .hh__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .hh__title {
    font-size: min(clamp(2.75rem, 1.6rem + 5.6vw, 5.75rem), 14vw);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 10ch;
  }

  .hh__lead {
    max-width: 28rem;
    color: rgb(248 250 252 / 0.82);
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.3125rem);
  }

  .hh__actions {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .hh__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(196 181 253 / 0.55);
    text-underline-offset: 0.3em;
  }

  .hh__visual {
    position: relative;
    display: grid;
    justify-items: center;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  /* Alt boşluk hap için: hap tabletin altında, telefonun solunda durur, ekranların
     üstüne binmez */
  /* %100: kenar boşluklarının içinde kalır (92vw dar ekranda sağa taşıp ortadan kayıyordu).
     Biraz daha uzun: tabletin altında, telefonun solunda hap için yer */
  .hh__visual :global(.hh__duo) {
    width: min(100%, 440px);
    aspect-ratio: 1 / 1.2;
  }

  .hh__pill {
    top: auto;
    bottom: 1.5cqw;
    left: 1cqw;
    display: inline-flex;
    align-items: center;
    gap: 2.4cqw;
    padding: 1.8cqw 3.4cqw 1.8cqw 1.8cqw;
    border-radius: 99px;
    background: rgb(59 20 38 / 0.96);
    box-shadow:
      0 0 0 1.5px rgb(244 63 94 / 0.55) inset,
      0 18px 40px rgb(5 2 25 / 0.6);
    font-size: max(12px, 3.6cqw);
    font-weight: 600;
    white-space: nowrap;
  }

  .hh__pill b {
    font-weight: 800;
  }

  .hh__pill-ic {
    display: grid;
    place-items: center;
    width: 5.6cqw;
    height: 5.6cqw;
    border-radius: 50%;
    background: rgb(244 63 94 / 0.22);
    color: #fb7185;
  }

  .hh__pill-ic svg {
    width: 3.4cqw;
    height: 3.4cqw;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hh__copy > * {
      animation: hh-rise 900ms var(--ease-out) both;
    }

    .hh__copy > :nth-child(2) {
      animation-delay: 80ms;
    }

    .hh__copy > :nth-child(3) {
      animation-delay: 160ms;
    }

    .hh__visual :global(.hh__duo) {
      animation: hh-rise 1100ms var(--ease-out) 120ms both;
    }

    .hh__pill {
      animation: hh-pill 700ms var(--ease-spring) 1300ms both;
    }
  }

  /* Yalnızca konum: metin ve telefon ilk boyamada görünür (LCP gecikmez) */
  @keyframes hh-rise {
    from {
      transform: translateY(18px);
    }
  }

  @keyframes hh-pill {
    from {
      opacity: 0;
      transform: translateX(-8cqw) scale(0.9);
    }
  }

  /* Mobilde hap çizginin solunda durur; HEDEF etiketi sağ uca geçer */
  @media (max-width: 59.99rem) {
    .hh__visual :global(.hh__traj .traj__goal-label) {
      left: auto;
      right: 0.625rem;
    }
  }

  @media (min-width: 48rem) {
    .hh__visual :global(.hh__duo) {
      width: min(100%, 520px);
    }
  }

  @media (min-width: 60rem) {
    .hh {
      padding-top: calc(var(--header-h) + var(--space-8));
    }

    .hh__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: center;
    }

    .hh__copy {
      justify-items: start;
      text-align: left;
      gap: var(--space-5);
    }

    .hh__actions {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }

    .hh__visual {
      margin-inline: 0;
      padding-inline: 0;
    }

    .hh__visual :global(.hh__duo) {
      width: min(100%, 540px);
    }

    .hh__visual :global(.hh__traj) {
      left: -40%;
      right: calc((100vw - 100%) / -2);
    }

    .hh__visual :global(.hh__traj > svg),
    .hh__visual :global(.hh__traj .traj__goal) {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%);
      mask-image: linear-gradient(90deg, transparent, #000 25%);
    }

    .hh__visual :global(.hh__traj .traj__goal-label) {
      left: 20%;
    }
  }

  /* ---------- Tek uygulama ---------- */
  .one {
    overflow-x: clip;
  }

  .one__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-7);
    text-align: center;
  }

  .one__head {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .one__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 44rem;
    list-style: none;
  }

  .one__list li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem 0.4rem 0.65rem;
    border-radius: 999px;
    background: rgb(20 14 54 / 0.9);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14) inset;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .one__list span {
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--violet-400);
  }

  /* ---------- Neden ---------- */
  .why__grid {
    display: grid;
    gap: var(--space-7);
  }

  .why__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .values {
    display: grid;
    gap: var(--space-5) var(--space-6);
    margin: 0;
  }

  .value {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    border-left: 2px solid transparent;
    border-image: linear-gradient(180deg, var(--violet-500), var(--flare-400)) 1;
  }

  .value dt {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .value dd {
    margin: 0;
    color: var(--text-2);
  }

  @media (min-width: 48rem) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .why__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }
  }

  /* ---------- Aile ---------- */
  .fam__head {
    margin-bottom: var(--space-7);
    max-width: 40rem;
  }

  .fam {
    display: grid;
    gap: var(--space-4);
  }

  .fam__main {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1.5px solid transparent;
    background:
      radial-gradient(28rem 18rem at 100% 0%, rgb(139 92 246 / 0.35), transparent 70%) padding-box,
      linear-gradient(160deg, var(--uv-800), var(--night-850)) padding-box,
      linear-gradient(140deg, rgb(139 92 246 / 0.9), rgb(224 86 253 / 0.5) 60%, rgb(255 255 255 / 0.1)) border-box;
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .fam__main:active {
    transform: scale(0.99);
  }

  .fam__main :global(.fam__mark) {
    width: 88px;
    height: 88px;
    margin-bottom: var(--space-2);
    filter: drop-shadow(0 10px 30px rgb(139 92 246 / 0.6));
  }

  .fam__meta,
  .fam__tag {
    font-family: var(--font-body);
  }

  .fam__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .fam__status,
  .fam__plat {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .fam__status {
    background: rgb(139 92 246 / 0.25);
    color: var(--violet-300);
  }

  .fam__plat {
    background: rgb(255 255 255 / 0.08);
    color: var(--text-2);
  }

  .fam__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .fam__tag {
    max-width: 30rem;
    color: var(--text-2);
  }

  .fam__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .fam__more :global(svg) {
    color: var(--violet-300);
    transition: rotate var(--dur-3) var(--ease-spring);
  }

  .fam__soon {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-xl);
    border: 1.5px dashed var(--line-strong);
  }

  .fam__soon-t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .fam__soon-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration-color: rgb(196 181 253 / 0.55);
    text-underline-offset: 0.3em;
  }

  @media (hover: hover) {
    .fam__main:hover {
      transform: translateY(-3px);
    }

    .fam__main:hover .fam__more :global(svg) {
      rotate: 90deg;
    }
  }

  @media (min-width: 48rem) {
    .fam {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }

    .fam__main {
      padding: var(--space-8);
    }

    .fam__main :global(.fam__mark) {
      position: absolute;
      top: var(--space-6);
      right: var(--space-6);
      width: 140px;
      height: 140px;
      z-index: -1;
    }
  }

  .proof {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin-top: var(--space-6);
  }
</style>
