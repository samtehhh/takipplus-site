---
import '../styles/tools.css';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Device from '../components/app/Device.astro';
import { faqLd } from '../lib/jsonld';
import { sessions } from '../data/tools';

const tyt = sessions[0];
const days = [
  { day: 'Cumartesi', date: '19 Haziran 2027', items: sessions.filter((s) => s.key === 'tyt') },
  { day: 'Pazar', date: '20 Haziran 2027', items: sessions.filter((s) => s.key !== 'tyt') },
];
const units = [
  ['d', 'GÜN'],
  ['h', 'SAAT'],
  ['m', 'DAKİKA'],
  ['s', 'SANİYE'],
];

const faq = [
  {
    q: 'YKS 2027 ne zaman?',
    a: '<p>ÖSYM 2027 sınav takvimini açıklayana kadar sayaç tahmini tarihleri kullanır: TYT 19 Haziran 2027 cumartesi, AYT ve YDT 20 Haziran 2027 pazar. Tahmin 2026 düzenine dayanır; 2026’da TYT 20 Haziran cumartesi, AYT ve YDT 21 Haziran pazar günü yapıldı. Resmî takvim açıklanınca sayaç güncellenir.</p>',
  },
  {
    q: 'YKS’ye kaç gün kaldı?',
    a: '<p>Sayfanın başındaki sayaç, TYT oturumunun başlayacağı saate (10.15) kalan süreyi gün, saat, dakika ve saniye olarak gösterir. Hesap Türkiye saatine göredir; cihazının saat diliminden etkilenmez.</p>',
  },
  {
    q: 'TYT, AYT ve YDT aynı gün mü yapılıyor?',
    a: '<p>Hayır. YKS iki güne yayılır: ilk gün TYT (120 soru, 165 dakika), ikinci gün sabah AYT (160 soru, 180 dakika), öğleden sonra YDT (80 soru, 120 dakika).</p>',
  },
  {
    q: 'Takip+ YKS’de sayaç var mı?',
    a: '<p>Var. Uygulamanın ana ekranındaki YKS 2027 kartı bu sayfadaki sayaçla aynı tarihi kullanır ve hemen altında hedef bölümünü gösterir. Android’de TYT, AYT ve YDT için ayrı ana ekran widget’ları da var.</p>',
  },
  {
    q: 'Deneme netimi nasıl hesaplarım?',
    a: '<p>Her testte net, doğru sayısından yanlış sayısının dörtte biri çıkarılarak bulunur. <a href="/net-hesaplama">Net Hesaplama</a> sayfasında doğru ve yanlışlarını yazman yeterli.</p>',
  },
];
---

<Base
  title="YKS 2027 Sayacı: YKS’ye Kaç Gün Kaldı?"
  description="YKS 2027’ye kaç gün kaldı? TYT, AYT ve YDT için Türkiye saatiyle saniye saniye geri sayım. Takip+ YKS uygulamasındaki sayacın aynısı."
  path="/yks-sayaci"
  ogImage="yks-sayaci"
  ogAlt="YKS 2027 Sayacı: YKS’ye kaç gün kaldı?"
  breadcrumbs={[{ name: 'YKS 2027 Sayacı', path: '/yks-sayaci' }]}
  jsonLd={[faqLd(faq)]}
  ctaHref="#erken-erisim"
>
  <section class="th" aria-labelledby="ys-title">
    <div class="th__sky atmo" aria-hidden="true"><span class="dotgrid"></span></div>
    <div class="container">
      <div class="th__head">
        <h1 class="th__title" id="ys-title">YKS 2027 Sayacı</h1>
        <p class="lead th__lead">YKS’ye kalan süre, Türkiye saatiyle saniye saniye. Takip+ YKS’nin ana ekranındaki sayacın aynısı.</p>
      </div>

      <!-- Uygulamadaki YksSayacWidget: başlık, alt başlık ve dört kutu -->
      <div class="app-card yc" data-yc={tyt.iso}>
        <div class="yc__head">
          <div>
            <p class="yc__title">YKS 2027</p>
            <p class="yc__kicker">SINAVA KALAN SÜRE</p>
          </div>
          <p class="yc__chip">Tahmini tarih</p>
        </div>
        <div class="yc__units" aria-hidden="true">
          {
            units.map(([k, l]) => (
              <div class="yc__unit">
                <b data-yc-unit={k}>00</b>
                <small>{l}</small>
              </div>
            ))
          }
        </div>
        <p class="sr-only" data-yc-sr></p>
        <p class="yc__when">
          <strong>TYT: {tyt.day}, saat {tyt.time}</strong>
        </p>
      </div>

      <dl class="span" data-span={tyt.iso}>
        <div>
          <dt>hafta</dt>
          <dd data-span-weeks>-</dd>
        </div>
        <div>
          <dt>hafta sonu</dt>
          <dd data-span-weekends>-</dd>
        </div>
        <div>
          <dt>ay, <span data-span-mdays>-</span> gün</dt>
          <dd data-span-months>-</dd>
        </div>
      </dl>
      <p class="fine ys-note">
        ÖSYM 2027 takvimini açıklayana kadar tarihler tahminidir; 2026 düzenine göre hesaplanır ve resmî takvim
        açıklanınca güncellenir.
      </p>
    </div>
  </section>

  <section class="section ys-days" aria-labelledby="days-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="days-title">İki gün, üç oturum.</h2>
        <p class="lead">YKS bir hafta sonuna yayılır: cumartesi sabahı TYT, pazar sabahı AYT, pazar öğleden sonra YDT.</p>
      </div>
      <div class="days">
        {
          days.map((d) => (
            <div class="day">
              <p class="day__head">
                <b>{d.day}</b> {d.date}
              </p>
              <ul class="day__list" role="list">
                {d.items.map((s) => (
                  <li class="session" data-session={s.iso} data-from={s.prevIso}>
                    <span class="session__time">{s.time}</span>
                    <span class="session__body">
                      <span class="session__name">
                        <b>{s.short}</b> {s.name}
                      </span>
                      <span class="session__detail">{s.detail}</span>
                      <span class="session__year">
                        Hazırlık yılı: <b data-session-pct>-</b> geride
                      </span>
                    </span>
                    <span class="session__days">
                      <b data-session-days>-</b>
                      <small>gün</small>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section defer" aria-labelledby="app-title">
    <div class="container tool-app">
      <Device screens={['p-home-sayac']} sizes="(min-width: 56rem) 300px, 64vw" class="tool-app__phone" />
      <div class="tool-app__copy">
        <h2 class="h2" id="app-title">Sayaç cebinde de çalışıyor.</h2>
        <p class="lead">
          Takip+ YKS’yi açtığında ilk gördüğün kart bu: YKS 2027’ye kalan süre ve hemen altında hedef bölümün.
          Android’de TYT, AYT ve YDT için ayrı ana ekran widget’ları da var; kalan günü uygulamayı açmadan görürsün.
        </p>
        <div class="tool-app__actions">
          <Button href="/yks" arrow track="cta_tool_sayac">Takip+ YKS’yi keşfet</Button>
          <a class="tool-app__link" href="#erken-erisim">Erken erişime katıl</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section defer" aria-label="Net Hesaplama">
    <div class="container">
      <a class="tool-link" href="/net-hesaplama">
        <span>
          <span class="tool-link__t">Denemeden yeni mi çıktın?</span>
          <span class="muted tool-link__d">Doğru ve yanlışlarını yaz; TYT ve AYT netin anında çıksın.</span>
        </span>
        <span class="btn btn--secondary btn--md btn--arrow" aria-hidden="true">
          <span class="btn__label">Net hesapla</span>
          <span class="btn__icon">
            <svg viewBox="0 0 20 20" width="16" height="16">
              <path d="M5 10h9.5M10.5 5.5 15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>
      </a>
    </div>
  </section>

  <section class="section defer" aria-labelledby="sss-title">
    <div class="container container-narrow">
      <h2 class="h2 ys-faq-title" id="sss-title">Sık sorulanlar</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section class="section defer">
    <div class="container">
      <WaitlistForm
        product="yks"
        text="Takip+ YKS mağazalara çıktığında ilk sen haberdar ol. Tek ihtiyacımız e-posta adresin; yalnızca yayın ve erken erişim hakkında yazarız."
      />
    </div>
  </section>
</Base>

<script>
  import '../scripts/tools';
</script>

<style>
  /* ---------- Sayaç kartı (uygulamadaki ölçülerle büyütülmüş) ---------- */
  .yc {
    display: grid;
    gap: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
    width: min(100%, 46rem);
    margin-inline: auto;
    padding: clamp(1.25rem, 0.8rem + 2.2vw, 2.5rem);
  }

  .yc__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .yc__title {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.2rem + 1.8vw, 2.5rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .yc__kicker {
    margin-top: 0.25rem;
    font-size: clamp(0.6875rem, 0.62rem + 0.25vw, 0.8125rem);
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--violet-400);
  }

  .yc__chip {
    flex: none;
    padding: 0.375rem 0.75rem;
    border-radius: 12px;
    background: rgb(139 92 246 / 0.12);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--violet-300);
  }

  .yc__units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 0.25rem + 1.2vw, 1.25rem);
  }

  /* JS yoksa yalnız tarih satırı; JS ilk hesabı yapana kadar yer tutar */
  .yc:not(.is-ready) .yc__units {
    visibility: hidden;
  }

  .yc__unit {
    display: grid;
    justify-items: center;
    gap: 0.625rem;
  }

  .yc__unit b {
    display: block;
    width: 100%;
    padding: clamp(0.625rem, 0.4rem + 1.2vw, 1.25rem) 0.25rem;
    border-radius: clamp(14px, 10px + 1vw, 22px);
    background: rgb(255 255 255 / 0.04);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.07) inset;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.2rem + 4.2vw, 4.75rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .yc__unit small {
    font-family: var(--font-body);
    font-size: clamp(0.625rem, 0.58rem + 0.2vw, 0.75rem);
    font-weight: 800;
    letter-spacing: 0.16em;
    color: var(--text-2);
  }

  .yc__when {
    font-size: var(--text-sm);
    color: var(--text-2);
  }

  .yc__when strong {
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
  }

  /* ---------- Kalan süre ---------- */
  .span {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: min(100%, 46rem);
    margin: var(--space-6) auto 0;
    text-align: center;
  }

  .span > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
    padding-inline: 0.5rem;
  }

  .span > div + div {
    box-shadow: -1px 0 0 var(--line);
  }

  .span dd {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .span dt {
    font-size: var(--text-sm);
    color: var(--text-2);
  }

  .span:not(.is-ready) {
    visibility: hidden;
  }

  .ys-note {
    max-width: 34rem;
    margin: var(--space-6) auto 0;
    text-align: center;
  }

  /* ---------- İki gün, üç oturum ---------- */
  .days {
    display: grid;
    gap: var(--space-5);
  }

  .day {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .day__head {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--text-2);
  }

  .day__head b {
    color: var(--text);
    font-weight: 700;
  }

  .day__list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
  }

  .session {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--grad-card);
    box-shadow: 0 0 0 1px var(--line) inset;
  }

  .session__time {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .session__body {
    display: grid;
    gap: 0.25rem;
  }

  .session__name {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
  }

  .session__name b {
    margin-right: 0.25rem;
    color: var(--violet-300);
    font-weight: 800;
  }

  .session__detail,
  .session__year {
    font-size: var(--text-xs);
    color: var(--text-2);
  }

  .session__year b {
    color: var(--text);
    font-weight: 700;
  }

  .session__days {
    display: grid;
    justify-items: end;
    font-family: var(--font-display);
  }

  .session__days b {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .session__days small {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-2);
  }

  /* JS yoksa canlı sayılar gizli kalır (yerleri korunur); tarih ve saat görünür */
  .session:not(.is-ready) .session__days,
  .session:not(.is-ready) .session__year {
    visibility: hidden;
  }

  /* Hazırlık yılı çizgisi: kartın alt kenarında, Android widget'ındaki yüzde */
  .session {
    position: relative;
    overflow: hidden;
  }

  .session::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--violet-500), var(--teal-400));
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  @media (min-width: 56rem) {
    .days {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- SSS ---------- */
  .ys-faq-title {
    margin-bottom: var(--space-6);
  }
</style>
