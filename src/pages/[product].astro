---
/**
 * Ürün sayfası şablonu. Her ürün için src/data/products.ts kaydı +
 * src/data/product-content/<slug>.ts içerik dosyası yeterli.
 * Görsel dil: mağaza görselleri (gece moru gökyüzü, kareli defter noktaları,
 * HEDEF çizgisi, gerçek ekranlar ve ekrandan taşan uygulama kartları).
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import StoreButtons from '../components/StoreButtons.astro';
import Faq from '../components/Faq.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Device from '../components/app/Device.astro';
import FocusQuad from '../components/app/FocusQuad.astro';
import Trajectory from '../components/app/Trajectory.astro';
import Tour from '../components/app/Tour.astro';
import ChapterVisual from '../components/app/ChapterVisual.astro';
import RepeatTimeline from '../components/app/RepeatTimeline.astro';
import ModuleCloud from '../components/app/ModuleCloud.astro';
import Plans from '../components/app/Plans.astro';
import Countdown from '../components/app/Countdown.astro';
import AppIcon from '../components/app/AppIcon.astro';
import Logo from '../components/Logo.astro';
import { products, type Product } from '../data/products';
import { mobileAppLd, faqLd } from '../lib/jsonld';
import { contactEmail } from '../config/site';

export async function getStaticPaths() {
  const contents = import.meta.glob('../data/product-content/*.ts', { eager: true });
  return products
    .filter((p) => p.status !== 'planned')
    .map((product) => ({
      params: { product: product.slug },
      props: { product, content: contents[`../data/product-content/${product.slug}.ts`] },
    }));
}

const { product, content: c } = Astro.props as { product: Product; content: typeof import('../data/product-content/yks') };
---

<Base
  title={c.seo.title}
  description={c.seo.description}
  path={`/${product.slug}`}
  ogImage={product.slug}
  ogAlt={`${product.name}: ${product.tagline}`}
  accent={{ base: product.accent, deep: product.accentDeep }}
  jsonLd={[...(product.released ? [mobileAppLd(product, c.seo.description)] : []), faqLd(c.faq)]}
  breadcrumbs={[{ name: product.name, path: `/${product.slug}` }]}
  ctaHref="#erken-erisim"
  stickyCta
>
  <!-- 1. Hero: mağaza görseli 01'in canlı hâli -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <div class="hero__sky" aria-hidden="true"><span class="dotgrid"></span></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="hero__status">
          <Logo size={22} wordmark={false} />
          {c.hero.status}
        </p>
        <h1 class="hero__title" id="hero-title">
          {c.hero.title.slice(0, -1).map((line) => <span class="hero__line">{line} </span>)}
          <span class="hero__goal">{c.hero.title.at(-1)}</span>
        </h1>
        <p class="lead hero__lead">{c.hero.lead}</p>
        <div class="hero__actions">
          {
            product.released ? (
              <StoreButtons product={product} />
            ) : (
              <Button href="#erken-erisim" size="lg" arrow track="cta_hero">
                Erken erişime katıl
              </Button>
            )
          }
          <a class="hero__link" href="#uygulama">Uygulamayı gez</a>
        </div>
      </div>

      <div class="hero__visual stage" role="img" aria-label={c.hero.visualLabel}>
        <Trajectory variant="hero" animate="intro" class="hero__traj" />
        <Device screens={['p-home-sayac']} sizes="(min-width: 60rem) 300px, (min-width: 48rem) 290px, 60vw" eager decorative class="hero__device">
          <div class="co co--plate hero__quad" style="--x:-17.2%;--y:73.1%;--ty:-50%;--w:134.5cqw">
            <FocusQuad animate="intro" />
          </div>
        </Device>
      </div>
      <p class="hero__fine">Görseller uygulamanın örnek veriyle çekilmiş ekranlarıdır.</p>
    </div>
  </section>

  <!-- 2. Tur: altı sekme -->
  <Tour id="uygulama" title={c.tour.title} lead={c.tour.lead} tabs={c.tour.tabs} />

  <!-- 3. Özellik bölümleri -->
  {
    c.chapters.map((ch) => (
      <section class:list={['chap', 'defer', `chap--${ch.layout}`]} id={ch.id} aria-labelledby={`${ch.id}-t`}>
        <div class="container chap__grid">
          <div class="chap__copy" data-reveal>
            <h2 class="h2" id={`${ch.id}-t`}>
              {ch.title}
            </h2>
            <p class="chap__text">{ch.text}</p>
            {ch.points && (
              <ul class="chap__points" role="list">
                {ch.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            {ch.note && <p class="chap__note">{ch.note}</p>}
          </div>
          <div class="chap__visual">
            <ChapterVisual kind={ch.visual} label={ch.label} tab={ch.tab} tabIcon={ch.tabIcon} />
          </div>
          {ch.layout === 'band' && (
            <div class="chap__band">
              <RepeatTimeline />
            </div>
          )}
        </div>
      </section>
    ))
  }

  <!-- 4. Saymakla bitmez -->
  <ModuleCloud id="moduller" title={c.modules.title} lead={c.modules.lead} items={c.modules.items} tabletLabel={c.modules.tabletLabel} />

  <!-- 5. Ücretsiz ve Premium -->
  <Plans
    id="premium"
    title={c.plans.title}
    lead={c.plans.lead}
    free={c.plans.free}
    premium={c.plans.premium}
    periods={c.plans.periods}
    foot={c.plans.foot}
  />

  <!-- 6. SSS -->
  <section class="section faq-sec defer" id="sss" aria-labelledby="sss-title">
    <div class="container faq-sec__grid">
      <div class="faq-sec__head">
        <h2 class="h2" id="sss-title">Sık sorulanlar</h2>
        <p class="muted">
          Cevabını bulamadığın bir şey varsa yaz, birkaç gün içinde dönelim.
        </p>
        <a class="faq-sec__mail" href={`mailto:${contactEmail}`}>
          <AppIcon name="mail" size={18} />
          {contactEmail}
        </a>
      </div>
      <Faq items={c.faq} />
    </div>
  </section>

  <!-- 7. Final: sayaç, hedefe varan çizgi ve bekleme listesi -->
  <section class="finale" aria-labelledby="finale-title">
    <div class="container finale__inner">
      <h2 class="finale__title" id="finale-title">Sayaç çalışıyor.</h2>
      <Countdown iso={c.exam.iso} label={c.exam.label} dateText={c.exam.dateText} note={c.exam.note} />
      {
        product.slug === 'yks' && (
          <a class="finale__tool" href="/yks-sayaci">
            TYT, AYT ve YDT için ayrı ayrı: YKS 2027 Sayacı
          </a>
        )
      }
    </div>
    <div class="finale__band" aria-hidden="true">
      <span class="dotgrid"></span>
      <Trajectory variant="finale" class="finale__traj" />
    </div>
    <div class="container finale__form">
      <WaitlistForm
        product={product.slug}
        text="Takip+ YKS mağazalara çıktığında ilk sen haberdar ol. Tek ihtiyacımız e-posta adresin; yalnızca yayın ve erken erişim hakkında yazarız."
      />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + var(--space-5));
  }

  .hero__sky {
    position: absolute;
    inset: 0 0 -12rem;
    z-index: -1;
    background:
      radial-gradient(70% 45% at 50% 62%, rgb(139 92 246 / 0.5), transparent 70%),
      radial-gradient(40% 30% at 80% 40%, rgb(224 86 253 / 0.22), transparent 70%),
      var(--grad-sky);
    -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent);
    mask-image: linear-gradient(180deg, #000 72%, transparent);
  }

  .hero__sky .dotgrid {
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent 85%);
    mask-image: linear-gradient(180deg, #000 40%, transparent 85%);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.875rem 0.3rem 0.35rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.16) inset;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgb(248 250 252 / 0.9);
  }

  .hero__status :global(.logo__mark) {
    border-radius: 6px;
  }

  /* "tek uygulamada." hiçbir genişlikte bölünmez; boyut ekrana göre ölçeklenir */
  .hero__title {
    font-size: min(10.6vw, 4.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .hero__line,
  .hero__goal {
    display: block;
    white-space: nowrap;
  }

  .hero__goal {
    color: var(--teal-400);
  }

  .hero__lead {
    max-width: 30rem;
    color: rgb(248 250 252 / 0.82);
    font-size: clamp(1.0625rem, 0.95rem + 0.45vw, 1.3125rem);
  }

  .hero__actions {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: rgb(196 181 253 / 0.55);
    text-underline-offset: 0.3em;
  }

  .hero__visual {
    position: relative;
    display: grid;
    justify-items: center;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .hero__visual :global(.hero__device) {
    --pw: min(60vw, 290px);
    width: var(--pw);
  }

  /* Not telefonun hemen altında, telefona ortalı (masaüstünde görsel sütununda) */
  .hero__fine {
    margin-top: calc(-1 * var(--space-3));
    font-size: var(--text-xs);
    color: var(--text-3);
    text-align: center;
  }

  @media (hover: hover) {
    .hero__link:hover {
      text-decoration-color: currentColor;
    }
  }

  /* Sayfa açılışı: başlık ve telefon tek bir sıralı giriş (yalnızca CSS) */
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * {
      animation: hero-rise 900ms var(--ease-out) both;
    }

    .hero__copy > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero__copy > :nth-child(3) {
      animation-delay: 140ms;
    }

    .hero__copy > :nth-child(4) {
      animation-delay: 220ms;
    }

    .hero__visual :global(.hero__device) {
      animation: hero-rise 1100ms var(--ease-out) 120ms both;
    }
  }

  /* Yalnızca konum: metin ve telefon ilk boyamada görünür (LCP gecikmez) */
  @keyframes hero-rise {
    from {
      transform: translateY(18px);
    }
  }

  @media (min-width: 48rem) {
    .hero__visual :global(.hero__device) {
      --pw: 290px;
    }
  }

  @media (min-width: 60rem) {
    .hero {
      padding-top: calc(var(--header-h) + var(--space-7));
    }

    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--space-7);
    }

    .hero__copy {
      justify-items: start;
      text-align: left;
      gap: var(--space-5);
    }

    /* Sol sütun ≈ (100vw − 88px) × 0,55; "tek uygulamada." ≈ 8,3 em */
    .hero__title {
      font-size: min(5.25rem, calc(6.5vw - 6px));
    }

    .hero__actions {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }

    .hero__visual {
      margin-inline: 0;
      padding-inline: 0;
    }

    .hero__visual :global(.hero__traj) {
      left: -30%;
      right: calc((100vw - 100%) / -2);
    }

    .hero__visual :global(.hero__traj > svg),
    .hero__visual :global(.hero__traj .traj__goal) {
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%);
      mask-image: linear-gradient(90deg, transparent, #000 22%);
    }

    .hero__visual :global(.hero__traj .traj__goal-label) {
      left: auto;
      right: 1.25rem;
    }

    .hero__visual :global(.hero__device) {
      --pw: 300px;
    }

    .hero__fine {
      grid-column: 2;
      margin-top: calc(-1 * var(--space-5));
    }
  }

  /* ---------- Özellik bölümleri ---------- */
  .chap {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }

  .chap__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .chap__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 34rem;
  }

  .chap__text {
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--text-2);
  }

  .chap__points {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    list-style: none;
  }

  .chap__points li {
    position: relative;
    padding-left: 1.75rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .chap__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 12px;
    height: 12px;
    background:
      linear-gradient(var(--violet-400), var(--violet-400)) center / 100% 2.5px no-repeat,
      linear-gradient(var(--violet-400), var(--violet-400)) center / 2.5px 100% no-repeat;
  }

  .chap__note {
    max-width: 32rem;
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--teal-400);
    border-radius: 0 12px 12px 0;
    background: rgb(45 212 191 / 0.06);
    font-size: var(--text-sm);
    color: var(--text-2);
  }

  .chap__visual {
    position: relative;
    display: grid;
    justify-items: center;
  }

  /* Poster ve çift telefon: ortalanmış başlık, altında sahne */
  .chap--poster .chap__copy,
  .chap--pair .chap__copy {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .chap--pair .chap__points {
    justify-items: center;
  }

  .chap--poster .chap__note {
    border-left: 0;
    border-radius: 12px;
    text-align: left;
  }

  .chap--poster,
  .chap--pair {
    overflow-x: clip;
  }

  .chap__band {
    width: 100%;
  }

  /* Yan yana yalnız geniş ekranda: kartlar telefonun iki yanından ~%20 taşar; tablette
     (768–959 px) sütun buna yetmiyor, kartlar sayfa kenarında kesiliyordu */
  @media (min-width: 60rem) {
    .chap--split .chap__grid,
    .chap--split-flip .chap__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }

    .chap--split-flip .chap__copy {
      order: 2;
    }
  }

  /* Bant: kart telefonun dışına taştığı için iki sütun ancak geniş ekranda */
  @media (min-width: 64rem) {
    .chap--band .chap__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'copy copy'
        'visual band';
      column-gap: var(--space-7);
      row-gap: var(--space-7);
    }

    .chap--band .chap__copy {
      grid-area: copy;
    }

    .chap--band .chap__visual {
      grid-area: visual;
    }

    .chap--band .chap__band {
      grid-area: band;
    }
  }

  @media (min-width: 64rem) {
    .chap--split .chap__grid,
    .chap--split-flip .chap__grid {
      gap: var(--space-9);
    }

    .chap--band .chap__copy {
      max-width: 40rem;
    }
  }

  /* ---------- SSS ---------- */
  .faq-sec__grid {
    display: grid;
    gap: var(--space-6);
  }

  .faq-sec__head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }

  .faq-sec__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .faq-sec__mail :global(svg) {
    flex: none;
    color: var(--violet-400);
  }

  @media (min-width: 60rem) {
    .faq-sec__grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: var(--space-9);
    }

    .faq-sec__head {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }

  /* ---------- Final ---------- */
  .finale {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: var(--section-y);
  }

  .finale::before {
    content: '';
    position: absolute;
    inset: 0 0 30%;
    z-index: -1;
    background:
      radial-gradient(60% 45% at 50% 40%, rgb(139 92 246 / 0.3), transparent 70%),
      radial-gradient(35% 30% at 76% 62%, rgb(45 212 191 / 0.1), transparent 70%);
  }

  .finale__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .finale__tool {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(196 181 253 / 0.55);
    text-underline-offset: 0.3em;
  }

  .finale__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  /* Hedefe varan çizgi: kendi şeridinde, metnin üstüne binmez */
  .finale__band {
    position: relative;
    height: clamp(150px, 22vw, 260px);
    margin-block: var(--space-5) var(--space-6);
  }

  .finale__band :global(.dotgrid) {
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
  }

  .finale__form {
    position: relative;
  }
</style>
