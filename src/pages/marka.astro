---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import { contactEmail } from '../config/site';

// Önizlemeler doğrudan kit dosyalarından (assets/brand/kit); indirme bağlantıları
// scripts/brand-assets.mjs'nin aynı yapıyla kopyaladığı public/brand/kit/ altına gider.
import glow from '../../assets/brand/kit/yks/png/isiltili-sembol-seffaf-1024.png';
import appIcon from '../../assets/brand/kit/yks/png/uygulama-ikonu-1024.png';
import flat from '../../assets/brand/kit/yks/svg/sembol-renkli.svg';
import flatLight from '../../assets/brand/kit/yks/svg/sembol-renkli-acik-zemin.svg';
import monoWhite from '../../assets/brand/kit/yks/svg/sembol-beyaz.svg';
import monoBlack from '../../assets/brand/kit/yks/svg/sembol-siyah.svg';
import yksDark from '../../assets/brand/kit/yks/svg/yatay-yks-koyu-zemin.svg';
import yksLight from '../../assets/brand/kit/yks/svg/yatay-yks-acik-zemin.svg';
import mainDark from '../../assets/brand/kit/ana/takipplus-yatay-koyu-zemin.svg';
import lgsDark from '../../assets/brand/kit/lgs/svg/yatay-lgs-koyu-zemin.svg';
import kpssDark from '../../assets/brand/kit/kpss/svg/yatay-kpss-koyu-zemin.svg';

const kit = (f: string) => `/brand/kit/${f}`;
const zip = { href: '/brand/takipplus-marka-kiti.zip', size: '2,5 MB' };

type Asset = { src: string; width: number; height: number };
type Stage = { img: Asset; bg: 'dark' | 'light'; kind?: 'raster' | 'wide' };
const logos: { name: string; note: string; stages: Stage[]; dl: [string, string][] }[] = [
  {
    name: 'Işıltılı sembol (ana)',
    note: 'Afiş, sunum ve büyük görseller. Yalnızca koyu zeminde, 64 px ve üzerinde.',
    stages: [{ img: glow, bg: 'dark', kind: 'raster' }],
    dl: [['PNG · 1024 px, şeffaf', kit('yks/png/isiltili-sembol-seffaf-1024.png')]],
  },
  {
    name: 'Uygulama ikonu',
    note: 'Tam zeminli ikon: mağaza görselleri ve profil fotoğrafı. Köşeleri platform yuvarlar; çerçeve ekleme.',
    stages: [{ img: appIcon, bg: 'dark', kind: 'raster' }],
    dl: [['PNG · 1024 px', kit('yks/png/uygulama-ikonu-1024.png')]],
  },
  {
    name: 'Düz sembol',
    note: 'Favicon, küçük arayüz, web başlığı ve baskı. 16 px’e kadar net. Açık zeminde artı laciverttir.',
    stages: [
      { img: flat, bg: 'dark' },
      { img: flatLight, bg: 'light' },
    ],
    dl: [
      ['SVG koyu zemin', kit('yks/svg/sembol-renkli.svg')],
      ['SVG açık zemin', kit('yks/svg/sembol-renkli-acik-zemin.svg')],
      ['SVG karo', kit('yks/svg/uygulama-karosu-duz.svg')],
    ],
  },
  {
    name: 'Tek renk',
    note: 'Bildirim ikonu, damga ve tek renk baskı.',
    stages: [
      { img: monoWhite, bg: 'dark' },
      { img: monoBlack, bg: 'light' },
    ],
    dl: [
      ['SVG beyaz', kit('yks/svg/sembol-beyaz.svg')],
      ['SVG lacivert', kit('yks/svg/sembol-siyah.svg')],
    ],
  },
  {
    name: 'Yatay logo: Takip+ YKS',
    note: 'Ürün adı Outfit 500, ürün renginde. En az 96 px genişlik.',
    stages: [
      { img: yksDark, bg: 'dark', kind: 'wide' },
      { img: yksLight, bg: 'light', kind: 'wide' },
    ],
    dl: [
      ['SVG koyu zemin', kit('yks/svg/yatay-yks-koyu-zemin.svg')],
      ['SVG açık zemin', kit('yks/svg/yatay-yks-acik-zemin.svg')],
      ['PNG koyu zemin', kit('yks/png/yatay-yks-koyu-zemin-seffaf@4x.png')],
      ['PNG açık zemin', kit('yks/png/yatay-yks-acik-zemin-seffaf@4x.png')],
    ],
  },
  {
    name: 'Yatay logo: Takip+',
    note: 'Ürün adı olmadan, şirketi anlatırken. Yazı logo da vektörel.',
    stages: [{ img: mainDark, bg: 'dark', kind: 'wide' }],
    dl: [
      ['SVG koyu zemin', kit('ana/takipplus-yatay-koyu-zemin.svg')],
      ['SVG açık zemin', kit('ana/takipplus-yatay-acik-zemin.svg')],
      ['Yazı logo SVG', kit('ana/takipplus-yazi-logo-koyu-zemin.svg')],
    ],
  },
];

const sizes = [
  ['Işıltılı', '≥ 64 px, yalnızca koyu zemin', 'Uygulama ikonu, mağaza, afiş, profil fotoğrafı'],
  ['Düz', '≥ 16 px', 'Favicon, arayüz, web başlığı, baskı'],
  ['Yatay logo', '≥ 96 px genişlik', 'Başlıklar, sunum kapakları, basın yazıları'],
];

const yks = [
  { n: 'Derin', hex: '#2A0E8F', role: 'Logo gradyanı başı' },
  { n: 'Çekirdek', hex: '#7C3AED', role: 'Logo gradyanı ortası, buton gradyanı' },
  { n: 'Işık', hex: '#E056FD', role: 'Logo gradyanı sonu' },
  { n: 'Electric Violet', hex: '#8B5CF6', role: 'UI vurgu: buton dolgusu, büyük başlık' },
  { n: 'UI güçlü', hex: '#6D28D9', role: 'Açık zeminde metin ve link' },
  { n: 'Koyu zeminde metin', hex: '#A78BFA', role: 'Koyu zeminde küçük metin ve link' },
];

const colors: { group: string; note?: string; items: { n: string; hex: string; role: string }[] }[] = [
  { group: 'Anlamsal', items: [
    { n: 'Başarı', hex: '#10B981', role: 'Tamamlandı, artış' },
    { n: 'Uyarı', hex: '#F59E0B', role: 'Dikkat, tekrar zamanı' },
    { n: 'Hata', hex: '#EF4444', role: 'Hata, yanlış' },
  ]},
  { group: 'Veri', note: 'Marka rengi değil; yalnızca grafik ve göstergelerde kullanılır.', items: [
    { n: 'Turkuaz', hex: '#2DD4BF', role: 'Günün Odağı: Soru, grafik çizgileri' },
  ]},
  { group: 'Nötr', items: [
    { n: 'Arka plan', hex: '#0F172A', role: 'Sayfa zemini' },
    { n: 'Yüzey', hex: '#141C2E', role: 'Bölümler, paneller' },
    { n: 'Kart', hex: '#232B44', role: 'Kart gradyanı başı (→ #1A2036)' },
    { n: 'Metin', hex: '#F8FAFC', role: 'Birincil metin' },
    { n: 'İkincil metin', hex: '#94A3B8', role: 'Açıklamalar' },
    { n: 'İkon zemini', hex: '#0B0B10', role: 'Uygulama ikonu, açılış ekranı' },
  ]},
];

const contrast = [
  ['#8B5CF6', '4.22', 'büyük metin', '4.23', 'büyük metin'],
  ['#A78BFA', '6.56', 'AA', '2.72', 'kullanma'],
  ['#6D28D9', '2.51', 'kullanma', '7.10', 'AAA'],
];

const family = [
  { name: 'Takip+ LGS', color: 'Mavi', logo: lgsDark, file: 'lgs/svg/yatay-lgs-koyu-zemin.svg', grad: ['#0A1F9E', '#1D6BFF', '#22E1FF'] },
  { name: 'Takip+ KPSS', color: 'Turuncu', logo: kpssDark, file: 'kpss/svg/yatay-kpss-koyu-zemin.svg', grad: ['#8A2100', '#F25C05', '#FFA51F'] },
];

const boilerplate =
  'Takip+, sınava hazırlanan öğrenciler için çalışma ve takip uygulamaları geliştiren bağımsız bir Türk girişimidir. İlk ürünü Takip+ YKS; konu takibi, deneme ve net analizi, Optik Çözüm, hedef belirleme, çalışma planı ve sosyal özellikleri tek uygulamada toplar. Takip+ 2026’da Samet Öndeş tarafından kuruldu.';
---

<Base
  title="Marka kiti"
  description="Takip+ logoları, uygulama ikonu, renkleri, yazı tipleri ve kısa marka metni. SVG ve PNG dosyalarını tek tek ya da tek zip olarak indir."
  path="/marka"
  ogImage="marka"
  breadcrumbs={[{ name: 'Marka kiti', path: '/marka' }]}
>
  <section class="kit-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container kit-hero__inner">
      <p class="label">Basın ve marka kiti</p>
      <h1 class="display kit-hero__title">Takip+ marka kiti</h1>
      <p class="lead">Logolar, uygulama ikonu, renkler, yazı tipleri ve kısa marka metni. Takip+ hakkında yazarken ya da bizi tanıtırken bu sayfadaki dosyaları kullanabilirsin.</p>
      <div class="kit-hero__cta">
        <Button href={zip.href} download size="lg" track="brand_kit_zip">Tüm kiti indir (.zip)</Button>
        <p class="fine">SVG ve PNG logolar, renk dosyaları · {zip.size} · Sürüm 1.0, Eylül 2026</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="oz-title">
    <div class="container kit-split">
      <div>
        <h2 class="h2" id="oz-title">Marka özü</h2>
      </div>
      <div class="kit-copy">
        <p class="kit-promise">Kendi ilerlemeni sen yönet.</p>
        <p class="muted">Değerlerimiz: <strong>netlik</strong>, <strong>disiplin</strong>, <strong>topluluk</strong> ve <strong>sahiplik</strong>. Ses tonumuz samimi, motive edici ve abartısız: öğrenciyle “sen” diye konuşur, yapmadığımız bir şeyi vaat etmeyiz.</p>
        <h3 class="h3">Kısa marka metni</h3>
        <blockquote class="kit-quote"><p>{boilerplate}</p></blockquote>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="logo-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="logo-title">Logolar</h2>
        <p class="lead">T+ işareti iki sürümde gelir. Işıltılı sürüm büyük boyut ve koyu zemin içindir; küçük boyutta ve açık zeminde aynı geometrideki düz sürüm kullanılır.</p>
      </div>
      <ul class="logos" role="list">
        {
          logos.map((l) => (
            <li class="logo-card">
              <div class:list={['logo-card__stages', { 'logo-card__stages--split': l.stages.length > 1 && l.stages[0].kind !== 'wide', 'logo-card__stages--stack': l.stages.length > 1 && l.stages[0].kind === 'wide' }]}>
                {l.stages.map((s) => (
                  <div class:list={['logo-card__stage', `logo-card__stage--${s.bg}`]}>
                    {s.kind === 'raster' ? (
                      <Image class:list={{ 'is-icon': l.name === 'Uygulama ikonu' }} src={s.img} alt={`Takip+ ${l.name.toLowerCase()}`} width={224} height={224} densities={[1, 2]} format="webp" loading="lazy" decoding="async" />
                    ) : (
                      <img class:list={{ 'is-wide': s.kind === 'wide' }} src={s.img.src} width={s.img.width} height={s.img.height} alt={`Takip+ ${l.name.replace(/^.*: /, '').toLowerCase()}, ${s.bg === 'dark' ? 'koyu' : 'açık'} zemin`} loading="lazy" decoding="async" />
                    )}
                  </div>
                ))}
              </div>
              <div class="logo-card__meta">
                <p class="logo-card__name">{l.name}</p>
                <p class="fine">{l.note}</p>
                <div class="logo-card__dl">
                  {l.dl.map(([label, href]) => (
                    <a href={href} download>
                      {label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="kit-table-wrap" role="region" aria-label="Hangi boyutta hangi sürüm? tablosu" tabindex="0">
        <table class="kit-table">
          <caption>Hangi boyutta hangi sürüm?</caption>
          <thead>
            <tr><th scope="col">Sürüm</th><th scope="col">En küçük boyut</th><th scope="col">Nerede</th></tr>
          </thead>
          <tbody>
            {sizes.map(([v, min, where]) => (
              <tr><th scope="row">{v}</th><td>{min}</td><td>{where}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="rules">
        <div class="rule rule--do">
          <h3 class="h3">Böyle kullan</h3>
          <ul>
            <li>Logonun çevresinde en az “+” işaretinin yüksekliği kadar boşluk bırak.</li>
            <li>Işıltılı sürümü yalnızca koyu zeminde ve 64 px ve üzerinde kullan.</li>
            <li>Açık zeminde açık zemin sürümünü kullan: T’nin gradyanı kalır, artı lacivert olur.</li>
            <li>Ürün adını “Takip+ YKS” biçiminde, artı işaretiyle ve bitişik yaz.</li>
          </ul>
        </div>
        <div class="rule rule--dont">
          <h3 class="h3">Böyle kullanma</h3>
          <ul>
            <li>Logoyu esnetme ya da döndürme; renklerini ve oranlarını değiştirme. Artı her zaman beyaz kalır.</li>
            <li>Parlama yalnızca hazır “ışıltılı” dosyalarda vardır. Düz sürüme sonradan gölge, parlama ya da kontur ekleme.</li>
            <li>Uygulama ikonunu ikinci bir kare çerçevenin içine koyma; logoyu kalabalık fotoğrafların üstünde kullanma.</li>
            <li>“Takip Plus”, “TakipPlus” ya da “Takip +” yazma.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="aile-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="aile-title">Ürün ailesi</h2>
        <p class="lead">Her ürün aynı T+ işaretini kullanır; yalnızca T’nin gradyanı ürüne göre değişir. Artı her zaman beyazdır, ailenin ortak imzası odur.</p>
      </div>
      <div class="family">
        <div class="family__lead">
          <img class="family__logo" src={yksDark.src} width={yksDark.width} height={yksDark.height} alt="Takip+ YKS yatay logo" loading="lazy" decoding="async" />
          <ul class="family__palette" role="list" aria-label="Takip+ YKS paleti">
            {yks.map((c) => (
              <li><span class="family__chip" style={`background:${c.hex}`} /><span class="num">{c.hex}</span></li>
            ))}
          </ul>
        </div>
        <ul class="family__next" role="list">
          {family.map((f) => (
            <li class="family__item">
              <img src={f.logo.src} width={f.logo.width} height={f.logo.height} alt={`${f.name} yatay logo`} loading="lazy" decoding="async" />
              <span class="family__bar" style={`background:linear-gradient(90deg, ${f.grad.join(', ')})`} />
              <p class="fine"><span class="family__soon">Yakında</span> {f.color} · <a href={kit(f.file)} download>Logo (SVG)</a></p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="renk-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="renk-title">Renkler</h2>
        <p class="lead">Takip+ YKS’nin moru markanın birincil rengidir. Nötrler bütün ürünlerde ortaktır.</p>
      </div>
      <div class="swatch-group">
        <h3 class="swatch-group__t">Takip+ YKS · mor</h3>
        <ul class="swatches" role="list">
          {yks.map((c) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background:${c.hex}`} />
              <span class="swatch__n">{c.n}</span>
              <span class="swatch__hex num">{c.hex}</span>
              <span class="swatch__role">{c.role}</span>
            </li>
          ))}
        </ul>
      </div>
      {
        colors.map((g) => (
          <div class="swatch-group">
            <h3 class="swatch-group__t">{g.group}</h3>
            {g.note && <p class="fine swatch-group__note">{g.note}</p>}
            <ul class="swatches" role="list">
              {g.items.map((c) => (
                <li class="swatch">
                  <span class="swatch__chip" style={`background:${c.hex}`} />
                  <span class="swatch__n">{c.n}</span>
                  <span class="swatch__hex num">{c.hex}</span>
                  <span class="swatch__role">{c.role}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="kit-table-wrap" role="region" aria-label="Kontrast (WCAG) tablosu" tabindex="0">
        <table class="kit-table">
          <caption>Kontrast (WCAG)</caption>
          <thead>
            <tr><th scope="col">Renk</th><th scope="col">#0F172A üzerinde</th><th scope="col">Beyaz üzerinde</th></tr>
          </thead>
          <tbody>
            {contrast.map(([hex, onDark, darkNote, onLight, lightNote]) => (
              <tr>
                <th scope="row"><span class="kit-table__dot" style={`background:${hex}`} /><span class="num">{hex}</span></th>
                <td><span class="num">{onDark}:1</span> <span class="kit-table__verdict">{darkNote}</span></td>
                <td><span class="num">{onLight}:1</span> <span class="kit-table__verdict">{lightNote}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="fine kit-table__note">Koyu zeminde küçük metin ve linkte <span class="num">#A78BFA</span>, açık zeminde <span class="num">#6D28D9</span> kullan. <span class="num">#8B5CF6</span> buton dolgusu ve büyük başlık içindir: koyu zeminde 4.22:1 ile küçük metin için AA sınırının (4.5:1) altında kalır.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="font-title">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" id="font-title">Yazı tipleri</h2>
        <p class="lead">Üçü de ücretsiz (SIL Open Font License) ve Türkçe karakterlerin tamamını destekler.</p>
      </div>
      <ul class="fonts" role="list">
        <li class="font-card">
          <p class="font-card__sample" style="font-family:var(--font-display);font-weight:800">Ağ Şİ çö</p>
          <p class="font-card__name">Outfit</p>
          <p class="fine">Logo ve başlıklar. Logo 800 ağırlık, hafif negatif harf aralığı; yatay logodaki ürün adı 500 ağırlık.</p>
        </li>
        <li class="font-card">
          <p class="font-card__sample" style="font-family:var(--font-body);font-weight:500">Ağ Şİ çö</p>
          <p class="font-card__name">Inter</p>
          <p class="fine">Gövde metni ve arayüz.</p>
        </li>
        <li class="font-card">
          <p class="font-card__sample num" style="font-weight:500">86,25</p>
          <p class="font-card__name">JetBrains Mono</p>
          <p class="fine">Rakamlar, süreler ve kod.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container kit-contact">
      <Logo size={40} />
      <p class="muted">Basın ve iş birliği talepleri için: <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
    </div>
  </section>
</Base>

<style>
  .kit-hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-8) var(--space-6);
  }

  .kit-hero__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .kit-hero__title {
    font-size: var(--text-3xl);
  }

  .kit-split {
    display: grid;
    gap: var(--space-5);
  }

  .kit-copy {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .kit-copy strong {
    color: var(--text);
  }

  .kit-promise {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .kit-quote {
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--slate-300);
  }

  .logos {
    display: grid;
    gap: var(--space-3);
    list-style: none;
  }

  .logo-card {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .logo-card__stages {
    display: grid;
    height: 176px;
  }

  .logo-card__stages--split {
    grid-template-columns: 1fr 1fr;
  }

  .logo-card__stages--stack {
    grid-template-rows: 1fr 1fr;
  }

  .logo-card__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: var(--space-5);
  }

  .logo-card__stages--stack .logo-card__stage {
    padding: var(--space-3) var(--space-5);
  }

  .logo-card__stage :global(img) {
    max-height: 112px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .logo-card__stages--split .logo-card__stage :global(img) {
    max-height: 72px;
  }

  .logo-card__stage :global(img.is-icon) {
    border-radius: 22%;
  }

  .logo-card__stage :global(img.is-wide) {
    max-height: 56px;
  }

  .logo-card__stages--stack .logo-card__stage :global(img.is-wide) {
    max-height: 44px;
  }

  .logo-card__stage--dark {
    background: var(--bg);
  }

  .logo-card__stage--light {
    background: #f8fafc;
  }

  .logo-card__meta {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-4) var(--space-3);
  }

  .logo-card__name {
    font-weight: 600;
  }

  .logo-card__dl {
    display: flex;
